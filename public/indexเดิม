/** 15. ปุ่มกดไฟนอล: เซฟประมวลผลปลายทางทั้งหมดโยนลงฐานข้อมูลคลาวด์ Firestore (ฉบับใช้งานจริงเปลี่ยนเป็น Popup ครบชุด) */
function finalSaveToFirestore(parentId) {
  // 1. เปลี่ยน Alert กรณีไม่พบข้อมูลบิล
  if (!currentDayBillsData || currentDayBillsData.length === 0) {
    systemAlert("⚠️ ไม่พบข้อมูลบิลที่จะบันทึกในระบบครับ", "ตรวจสอบข้อมูล", "danger");
    return;
  }

  // 2. เปลี่ยน Confirm ยืนยันการบันทึกข้อมูล ให้มาใช้ระบบ Callback ของ systemConfirm
  systemConfirm(
    `คุณต้องการยืนยันการบันทึกตรวจสอบข้อมูล Cash Out\nของ ${parentId} หรือไม่?`,
    `<i class="bi bi-cloud-arrow-up"></i> ยืนยันความถูกต้องข้อมูล`,
    `warning`,
    function() {
      // 🚀 บล็อกนี้จะทำงานทันทีหลังจากยูสเซอร์คลิกปุ่ม "ตกลง" ในหน้าป๊อปอัป
      if (typeof showLoading === 'function') {
        showLoading("กำลังบันทึกข้อมูล...");
      }

      // เรียกใช้หลังบ้าน นำส่งพาร์ทวันที่และอาร์เรย์จำที่มีข้อมูลร้านค้าและประเภทค่าใช้จ่ายใหม่เข้าไปเซฟ
      google.script.run
        .withSuccessHandler((response) => {
          if (typeof hideLoading === 'function') hideLoading();
          
          if (response === "success") {
            if (typeof showToast === 'function') {
              showToast("🎉 บันทึกข้อมูลและยืนยัน Cash Out สำเร็จแล้ว!", "success");
            }
            
            // 3. เปลี่ยน Alert กรณีบันทึกสำเร็จ เป็นป๊อปอัปสีเขียวสุดเนียน
            systemAlert(
              "📊 บันทึกข้อมูล\nเรียบร้อยครับ!", 
              "บันทึกข้อมูลสำเร็จ", 
              "success"
            );
            
            loadAllCashouts(); // สั่งรีโหลดหน้าตารางหลักทันทีเพื่ออัปเดต Badge เป็นสีเขียว "ตรวจสอบแล้ว"
          } else {
            // 4. เปลี่ยน Alert กรณีระบุ Error จากคลาวด์
            systemAlert("⚠️ แจ้งเตือน: " + response, "พบข้อผิดพลาดจากระบบ", "danger");
          }
        })
        .withFailureHandler((err) => {
          if (typeof hideLoading === 'function') hideLoading();
          console.error("❌ ไม่สามารถเซฟข้อมูลได้:", err);
          
          // 5. เปลี่ยน Alert กรณีหลังบ้านพังหรือ Network หลุด
          systemAlert("❌ เกิดข้อผิดพลาดจากฐานข้อมูล:\n" + err.message, "การเชื่อมต่อขัดข้อง", "danger");
        })
        .saveAllDayBillsToFirestore(parentId, currentDayBillsData); // ยิงส่งไปหลังบ้าน
    }
  );
}


function systemConfirm(message, title, type, onConfirm) {
  const modalEl = document.getElementById('systemNotificationModal');
  const header = document.getElementById('notiModalHeader');
  const titleEl = document.getElementById('notiModalTitle');
  const msgEl = document.getElementById('notiModalMessage');
  const iconEl = document.getElementById('notiModalIcon');
  const cancelBtn = document.getElementById('notiCancelBtn');
  const confirmBtn = document.getElementById('notiConfirmBtn');

  titleEl.innerHTML = title || '❓ ยืนยันการดำเนินการ';
  msgEl.innerText = message;
  cancelBtn.style.display = 'block'; // เปิดแสดงปุ่มยกเลิกขนาบข้าง
  
  // ปรับแต่งสีหัวข้อและสัญลักษณ์ตามระดับความสำคัญ
  if (type === 'warning') {
    header.className = "modal-header bg-warning text-dark py-2";
    confirmBtn.className = "btn btn-sm btn-warning text-dark px-4 fw-bold";
    iconEl.innerHTML = `<i class="bi bi-exclamation-triangle-fill text-warning"></i>`;
  } else {
    header.className = "modal-header bg-primary text-white py-2";
    confirmBtn.className = "btn btn-sm btn-primary px-4 fw-bold";
    iconEl.innerHTML = `<i class="bi bi-question-circle-fill text-primary"></i>`;
  }

  // ผูกฟังก์ชันการทำงานเมื่อกดปุ่ม "ตกลง"
  notiConfirmCallback = onConfirm;
  confirmBtn.onclick = function() {
    const myModal = bootstrap.Modal.getInstance(modalEl);
    if (myModal) myModal.hide();
    if (typeof notiConfirmCallback === 'function') notiConfirmCallback();
  };

  const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
  bsModal.show();
}

/**
 * 🔔 ฟังก์ชันเรียกใช้ป๊อปอัปแจ้งบอกข้อมูลสถานะ (มาแทนคำสั่ง alert() เดิม)
 */
function systemAlert(message, title, type) {
  const modalEl = document.getElementById('systemNotificationModal');
  const header = document.getElementById('notiModalHeader');
  const titleEl = document.getElementById('notiModalTitle');
  const msgEl = document.getElementById('notiModalMessage');
  const iconEl = document.getElementById('notiModalIcon');
  const cancelBtn = document.getElementById('notiCancelBtn');
  const confirmBtn = document.getElementById('notiConfirmBtn');

  titleEl.innerHTML = title || '📢 แจ้งเตือนจากระบบ';
  msgEl.innerText = message;
  cancelBtn.style.display = 'none'; // ซ่อนปุ่มยกเลิกทิ้งไปเพราะเป็นโหมดแจ้งเพื่อทราบ
  
  if (type === 'success') {
    header.className = "modal-header bg-success text-white py-2";
    confirmBtn.className = "btn btn-sm btn-success px-4 fw-bold";
    iconEl.innerHTML = `<i class="bi bi-check-circle-fill text-success"></i>`;
  } else if (type === 'danger') {
    header.className = "modal-header bg-danger text-white py-2";
    confirmBtn.className = "btn btn-sm btn-danger px-4 fw-bold";
    iconEl.innerHTML = `<i class="bi bi-x-circle-fill text-danger"></i>`;
  } else {
    header.className = "modal-header bg-dark text-white py-2";
    confirmBtn.className = "btn btn-sm btn-dark px-4 fw-bold";
    iconEl.innerHTML = `<i class="bi bi-info-circle-fill text-dark"></i>`;
  }

  // เมื่อกดยืนยันรับทราบให้ปิดกล่องทันที
  confirmBtn.onclick = function() {
    const myModal = bootstrap.Modal.getInstance(modalEl);
    if (myModal) myModal.hide();
  };

  const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
  bsModal.show();
}
