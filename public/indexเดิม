function saveIncomeData() {
  if (!currentIncomeData) return showToast("ไม่พบข้อมูลที่จะบันทึก", "error");

  const getNumVal = (id) => {
    const el = document.getElementById(id);
    return el ? parseFloat(el.value) || 0 : 0;
  };

  const getAdjValue = (signId, valId) => {
    const sign = document.getElementById(signId).value === 'minus' ? -1 : 1;
    const val = parseFloat(document.getElementById(valId).value) || 0;
    return sign * val;
  };

  const displayEl = document.getElementById('displayDiff');
  const netCash = displayEl ? parseFloat(displayEl.innerText.replace(/,/g, '')) : 0;

  let tipMethod = "";
  const tipValue = getNumVal('inputTip');
  if (tipValue > 0) {
    const selected = document.querySelector('input[name="tipPaymentMethod"]:checked');
    tipMethod = selected ? selected.value : "";
  }

  // เตรียมชุด Payload ครบทุกมิติฟิลด์เดิม
  const data = {
    date: currentIncomeData.dateRaw, 
    store: currentIncomeData.store || currentIncomeData.shop, 
    cash_out: getNumVal('inputCashout'),
    tip: tipValue,
    tip_type: tipMethod,
    other_exp: getNumVal('inputOther'),
    net_cash: netCash, 
    adj_visa: getAdjValue('adjSignVisa', 'adjValVisa'),
    adj_master: getAdjValue('adjSignMaster', 'adjValMaster'),
    adj_transfer: getAdjValue('adjSignTransfer', 'adjValTransfer'),
    adj_cash: getAdjValue('adjSignCash', 'adjValCash'),
    status: "done" 
  };

  showLoading("กำลังบันทึกข้อมูล...");

  const storedUser = sessionStorage.getItem("current_user");
  const currentUserObj = storedUser ? JSON.parse(storedUser) : null;

  google.script.run.withSuccessHandler((res) => {
    hideLoading();
    if (res === "success") {
      // เปลี่ยนเงื่อนไขการหาตำแหน่ง Array ในหน่วยความจำชั่วคราว ให้เช็คคู่จาก วันที่ และ ชื่อร้าน ตรง ๆ
      const index = allIncomes.findIndex(item => item.dateRaw === data.date && (item.shop === data.store || item.store === data.store));

      if (index !== -1) {
        allIncomes[index] = { ...allIncomes[index], ...data };
        filterIncomeTable(); 
      }

      document.getElementById('incomeEditSection').classList.add('d-none');
      document.getElementById('saveSuccessSection').classList.remove('d-none');
      showToast("บันทึกข้อมูลสำเร็จ", "success");
      
    } else {
      showToast("เกิดข้อผิดพลาด: " + res, "error");
    }
  }).withFailureHandler((err) => {
    hideLoading();
    showToast("Server Error: " + err.message, "error");
  }).updateIncomeRecord(data, currentUserObj); // 🎯 [แก้ไขจุดสำคัญ]: ใส่พ่วง currentUserObj ปิดท้ายวงเล็บตรงนี้ เพื่อเปิดท่อส่งตัวตนพนักงานไปหลังบ้านสำเร็จครับ!
}

