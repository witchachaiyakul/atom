}

/** 🎯 ฟังก์ชันอัปเดตชื่อ Supplier ลงตัวแปรจำ */
function savePopupSupplierToCache() {
  const supplierInput = document.getElementById('popupBillSupplierInput');
  if (supplierInput && currentActiveBillIndex !== null && currentDayBillsData[currentActiveBillIndex]) {
    const newSupplier = supplierInput.value.trim();
    const currentBill = currentDayBillsData[currentActiveBillIndex];
    const oldSupplier = currentBill.supplier;
    
    // อัปเดตชื่อ Supplier ใหม่ลงตัวแปรหลัก
    currentBill.supplier = newSupplier;
    
    // 💡 ถ้าพนักงานพิมพ์เปลี่ยนชื่อไปตรงกับคู่ค้าใน supplierCategoryMap ให้เปลี่ยนหมวดหมู่อัตโนมัติ
    if (newSupplier !== oldSupplier && supplierCategoryMap[newSupplier]) {
      currentBill.category = supplierCategoryMap[newSupplier];
    }
  }
}

function controlPopupImage(action) {
  const img = document.getElementById('popupBillImgTarget');
  if (!img) return;

  if (action === 'zoomIn') imgZoomScale += 0.2;
  if (action === 'zoomOut') imgZoomScale = Math.max(0.2, imgZoomScale - 0.2);
  if (action === 'rotateRight') imgRotateDegree += 90;
  if (action === 'rotateLeft') imgRotateDegree -= 90;
  if (action === 'reset') { 
    imgZoomScale = 1; 
    imgRotateDegree = 0; 
    imgPanX = 0; 
    imgPanY = 0; 
  }

  // อัปเดตรูปแบบการ Transform ของ CSS โดยรวมเอาทั้ง scale, translate (พิกัดเลื่อน) และ rotate มารวมกัน
  img.style.transform = `scale(${imgZoomScale}) translate(${imgPanX}px, ${imgPanY}px) rotate(${imgRotateDegree}deg)`;
}

/** 🎯 [เพิ่มส่วนการดักจับ Event]: ผูกการทำงานทันทีเมื่อหน้าต่างเว็บแอปโหลดขึ้นมา */
document.addEventListener("DOMContentLoaded", function() {
  const wrapper = document.getElementById('popupImgWrapper');
  const img = document.getElementById('popupBillImgTarget');
  
  if (!wrapper || !img) return;

  // 1. ⚙️ ระบบ Scroll เมาส์เพื่อซูมเข้า - ซูมออก (Mouse Wheel Zoom)
  wrapper.addEventListener('wheel', function(e) {
    e.preventDefault(); // ป้องกันไม่ให้หน้าจอหลักขยับเลื่อนขึ้นลงขณะจะซูมภาพ
    
    // ตรวจสอบทิศทางการ Scroll
    if (e.deltaY < 0) {
      imgZoomScale += 0.1; // เลื่อนลูกกลิ้งขึ้น = ซูมเข้า
    } else {
      imgZoomScale = Math.max(0.2, imgZoomScale - 0.1); // เลื่อนลูกกลิ้งลง = ซูมออก
    }
    
    controlPopupImage('update'); // สั่งอัปเดตหน้าจอภาพ
  });

  // 2. ⚙️ ระบบกดเมาส์ค้างเพื่อเตรียมลากจับภาพ (Mouse Down)
  img.addEventListener('mousedown', function(e) {
    e.preventDefault();
    isDraggingImg = true;
    img.style.cursor = 'grabbing'; // เปลี่ยนสัญลักษณ์เมาส์เป็นรูปมือกำแน่น
    
    // บันทึกตำแหน่งเมาส์ตอนเริ่มต้นลาก หักลบกับพิกัดที่เคยขยับไปแล้วก่อนหน้านี้
    startDragX = e.clientX - imgPanX;
    startDragY = e.clientY - imgPanY;
  });

  // 3. ⚙️ ระบบคำนวณระยะการขยับพิกัดขณะกำลังลากเมาส์ (Mouse Move)
  document.addEventListener('mousemove', function(e) {
    if (!isDraggingImg) return; // ถ้าไม่ได้กดเมาส์ค้างที่รูปภาพไว้ ไม่ต้องคำนวณ
    
    // คำนวณพิกัดแกน X และแกน Y ใหม่สัมบูรณ์
    imgPanX = e.clientX - startDragX;
    imgPanY = e.clientY - startDragY;
    
    // แสดงผลความเคลื่อนไหวของรูปตามเมาส์
    img.style.transform = `scale(${imgZoomScale}) translate(${imgPanX}px, ${imgPanY}px) rotate(${imgRotateDegree}deg)`;
  });

  // 4. ⚙️ ระบบเมื่อปล่อยเมาส์ หรือเมาส์หลุดออกจากเขตควบคุม (Mouse Up / Mouse Leave)
  const stopDragging = function() {
    if (isDraggingImg) {
      isDraggingImg = false;
      img.style.cursor = 'grab'; // คืนค่าเมาส์เป็นรูปมือกางปกติ
    }
  };
  
  document.addEventListener('mouseup', stopDragging);
  wrapper.addEventListener('mouseleave', stopDragging);
});

