// ==========================================
// ระบบตรวจ Audit Cashout (หน้าบ้าน)
// ==========================================

// 1. ตั้งค่าเริ่มต้นเดือนปัจจุบันเมื่อโหลดหน้าเว็บครั้งแรก
document.addEventListener("DOMContentLoaded", () => {
  const monthInput = document.getElementById('auditFilterMonth');
  if (monthInput && !monthInput.value) {
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, '0');
    monthInput.value = `${yyyy}-${mm}`;
  }
});

// 2. ฟังก์ชันดึงข้อมูลตรวจสอบ Audit
function loadCashoutAudit() {
  if (typeof showLoading === 'function') showLoading("กำลังตรวจสอบข้อมูล Cash Out...");

  const fMonth = document.getElementById('auditFilterMonth') ? document.getElementById('auditFilterMonth').value : '';
  const fShop = document.getElementById('auditFilterShop') ? document.getElementById('auditFilterShop').value : 'All';
  const fStatus = document.getElementById('auditFilterStatus') ? document.getElementById('auditFilterStatus').value : 'ALL';

  const filterObj = {
    month: fMonth,
    shop: fShop,
    statusFilter: fStatus,
    hideNoData: true // ซ่อนวันที่ไม่มีการเคลื่อนไหวทั้งสองฝั่ง
  };

  google.script.run
    .withSuccessHandler((response) => {
      renderAuditSummary(response.summary);
      renderAuditTable(response.items);
      if (typeof hideLoading === 'function') hideLoading();
    })
    .withFailureHandler((err) => {
      console.error("Audit Error: " + err.message);
      if (typeof hideLoading === 'function') hideLoading();
      if (typeof showToast === 'function') showToast("เกิดข้อผิดพลาด: " + err.message, "error");
    })
    .checkCashoutAuditData(filterObj);
}

// 3. แสดงผล Summary Cards (พร้อม Safety Check)
function renderAuditSummary(summary) {
  // รองรับทั้ง ID auditSummaryCards และ auditSummaryContainer
  const container = document.getElementById('auditSummaryCards') || document.getElementById('auditSummaryContainer');
  if (container) container.style.display = 'flex';

  if (!summary) return;

  const elMismatch = document.getElementById('sumMismatch');
  const elPending = document.getElementById('sumPending');
  const elMatch = document.getElementById('sumMatch');

  if (elMismatch) elMismatch.innerText = (summary.mismatch || 0).toLocaleString();
  if (elPending) elPending.innerText = (summary.pending || 0).toLocaleString();
  if (elMatch) elMatch.innerText = (summary.match || 0).toLocaleString();
}

// 4. เรนเดอร์ข้อมูลลงตาราง
// เรนเดอร์ข้อมูลลงตาราง (ตัดคอลัมน์สถานะและบิลออก)
function renderAuditTable(items) {
  const tbody = document.getElementById('auditTableBody');
  if (!tbody) return;

  if (!items || items.length === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="5" class="text-center py-5 text-muted">
          <i class="bi bi-inbox fs-2 d-block mb-2"></i>
          ไม่พบรายการที่ตรงตามเงื่อนไข
        </td>
      </tr>`;
    return;
  }

  let html = '';
  items.forEach(item => {
    // ยังคงไฮไลท์สีแถวตามความผิดปกติของยอดเงิน
    let rowClass = '';
    if (item.auditStatus === 'MISMATCH') {
      rowClass = 'table-danger';   // สีแดง ถ้ายอดไม่ตรง
    } else if (item.auditStatus === 'PENDING_INPUT') {
      rowClass = 'table-warning';  // สีเหลือง ถ้ายังไม่คีย์ระบบ
    }

    const billAmountStr = item.billTotalAmount > 0 
      ? `฿${item.billTotalAmount.toLocaleString('th-TH', {minimumFractionDigits: 2, maximumFractionDigits: 2})}` 
      : '-';
    const cashAmountStr = item.cashOutAmount > 0 
      ? `฿${item.cashOutAmount.toLocaleString('th-TH', {minimumFractionDigits: 2, maximumFractionDigits: 2})}` 
      : '-';
    const diffStr = item.diffAmount > 0 
      ? `฿${item.diffAmount.toLocaleString('th-TH', {minimumFractionDigits: 2, maximumFractionDigits: 2})}` 
      : '-';

    html += `
      <tr class="${rowClass}">
        <td class="fw-semibold">${item.dateKey}</td>
        <td><span class="fw-bold">${item.shop}</span></td>
        <td class="text-end fw-bold text-primary">${billAmountStr}</td>
        <td class="text-end">${cashAmountStr}</td>
        <td class="text-end fw-bold ${item.diffAmount > 0 ? 'text-danger' : 'text-muted'}">${diffStr}</td>
      </tr>
    `;
  });

  tbody.innerHTML = html;
}
    
