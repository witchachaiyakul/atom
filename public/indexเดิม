        .deleteInvoiceFromFirestore(docId, currentUserObj);
}


/** ฟังก์ชันกรองรายการตั้งเบิกแยกตาม Supplier, Shop และ Amount */
function filterClaimList() {
  const sSupplier = document.getElementById('claimSearchSupplier').value.toLowerCase().trim();
  const sShop = document.getElementById('claimSearchShop').value.toLowerCase().trim();
  // รับค่ายอดเงินและลบคอมม่าออก (เผื่อผู้ใช้ก๊อปปี้มาวาง)
  const sAmount = document.getElementById('claimSearchAmount').value.replace(/,/g, '').trim(); 
  
  const rows = document.querySelectorAll('.claim-row');
  let visibleCount = 0;

  rows.forEach(row => {
    const tSupplier = (row.getAttribute('data-supplier') || "").toLowerCase();
    const tShop = (row.getAttribute('data-shop') || "").toLowerCase();
    // ดึงค่าจำนวนเงิน และลบคอมม่าออกเพื่อให้เป็นตัวเลข String บริสุทธิ์
    const tAmount = (row.getAttribute('data-amount') || "").replace(/,/g, ''); 

    // 1. กรอง Supplier
    const matchSupplier = sSupplier === "" || tSupplier.includes(sSupplier);

    // 2. กรอง Shop (Logic พิเศษสำหรับ Atom)
    let matchShop = false;
    if (sShop === "") {
      matchShop = true;
    } else if (sShop === "atom") {
      matchShop = (tShop === "atom");
    } else {
      matchShop = tShop.includes(sShop);
    }

    // 3. กรองยอดเงิน (รองรับการหาเลขทศนิยมหรือเลขจำนวนเต็ม)
    // ใช้ includes บนตัวเลขที่ลบคอมม่าแล้ว จะทำให้พิมพ์ "2654" แล้วเจอ "2,654.90" ได้แม่นยำ
    const matchAmount = sAmount === "" || tAmount.includes(sAmount);

    const isMatch = matchSupplier && matchShop && matchAmount;
    row.style.display = isMatch ? "" : "none";
    if (isMatch) visibleCount++;
  });

  // อัปเดตตัวนับ
  const searchCountEl = document.getElementById('searchCount');
  if (searchCountEl) searchCountEl.innerText = `พบทั้งหมด ${visibleCount} รายการ`;

  // จัดการ Message เมื่อไม่พบข้อมูล
  const area = document.getElementById('claimListArea');
  let noResultMsg = document.getElementById('noResultMsg');

  if (visibleCount === 0) {
    if (!noResultMsg) {
      const div = document.createElement('div');
      div.id = 'noResultMsg';
      div.className = 'text-center py-5 text-muted';
      div.innerHTML = '<i class="bi bi-search fs-2"></i><p class="mt-2">ไม่พบรายการที่ตรงกับเงื่อนไข</p>';
      area.appendChild(div);
    }
  } else if (noResultMsg) {
    noResultMsg.remove();
  }
}

function selectAllVisible(status) {
  const isChecked = !!status; // แปลงเป็น Boolean (true/false)
  const rows = document.querySelectorAll('.claim-row');
  
  rows.forEach(row => {
    // 1. เช็คว่าแถวนี้ "แสดงผลอยู่" (ไม่ถูก Filter ซ่อน)
    const isVisible = row.offsetWidth > 0 && row.offsetHeight > 0;

    if (isVisible) {
      const chk = row.querySelector('.row-chk');
      
      // 2. ตรวจสอบว่ามี Checkbox และสถานะไม่ตรงกับที่ต้องการเปลี่ยน
      if (chk && chk.checked !== isChecked) {
        const dataStr = row.getAttribute('data-item');
        
        if (dataStr) {
          try {
            const itemData = JSON.parse(dataStr);
            
            // 3. ตรวจสอบโดยใช้ docId (ให้ตรงกับ toggleItem ที่คุณใช้)
            if (itemData && itemData.docId) { 
              chk.checked = isChecked;
              toggleItem(itemData); // ส่งไปคำนวณยอดและเพิ่มลง selectedRows
            } else {
              console.warn("⚠️ ข้อมูลใน data-item ไม่มี docId:", itemData);
            }
          } catch (e) {
            console.error("❌ JSON Parse Error:", e);
          }
        }
      }
    }
  });
}

/** ฟังก์ชันกรองรายการจากการพิมพ์ค้นหา */
function filterPaymentList() {
  const sRef = document.getElementById('paySearchRef').value.toLowerCase().trim();
  const sSupplier = document.getElementById('paySearchSupplier').value.toLowerCase().trim();
  const sShop = document.getElementById('paySearchShop').value.toLowerCase().trim();
  const sAmount = document.getElementById('paySearchAmount').value.trim(); 
  
  const rows = document.querySelectorAll('.payment-row'); 
  let visibleCount = 0;

  rows.forEach(row => {
    const tRef = (row.getAttribute('data-ref') || "").toLowerCase().trim();
    const tSupplier = (row.getAttribute('data-supplier') || "").toLowerCase().trim();
    const tShop = (row.getAttribute('data-shop') || "").toLowerCase().trim();
    const tAmount = (row.getAttribute('data-amount') || "").toString().trim(); 

    const matchRef = sRef === "" || tRef.includes(sRef);
    const matchSupplier = sSupplier === "" || tSupplier.includes(sSupplier);
    const matchShop = sShop === "" || tShop.includes(sShop);

    let matchAmount = true;
    if (sAmount !== "") {
      const cleanTAmount = tAmount.replace(/,/g, ""); 
      const cleanSAmount = sAmount.replace(/,/g, ""); 
      matchAmount = cleanTAmount.includes(cleanSAmount);
    }

    const isMatch = matchRef && matchSupplier && matchShop && matchAmount;
    row.style.display = isMatch ? "" : "none";
    if (isMatch) visibleCount++;
  });

  const searchCountEl = document.getElementById('searchCount');
  if (searchCountEl) searchCountEl.innerText = `พบทั้งหมด ${visibleCount} รายการ`;

  // จัดการข้อความแจ้งเตือน
  const area = document.getElementById('paymentListArea');
  let noResultMsg = document.getElementById('noPaymentResultMsg');

  if (visibleCount === 0 && rows.length > 0) {
    if (!noResultMsg) {
      const div = document.createElement('div');
      div.id = 'noPaymentResultMsg';
      div.className = 'text-center py-5 text-muted';
      div.innerHTML = '<div class="mb-2"><i class="bi bi-search fs-2"></i></div><p>ไม่พบรายการที่ตรงเงื่อนไข</p>';
      area.appendChild(div);
    }
  } else if (noResultMsg) {
    noResultMsg.remove();
  }
}

