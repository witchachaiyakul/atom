            data.forEach(item => {
                const itemJson = JSON.stringify(item).replace(/'/g, "&apos;");
                
                const cleanRef = String(item.ref || item.Ref || "").trim().toLowerCase();
                const cleanSupplier = String(item.supplier || item.Supplier || "").trim().toLowerCase();
                const cleanShop = String(item.shop || item.Shop || "").trim().toLowerCase();
                const cleanAmount = String(item.amount || 0).replace(/,/g, "");

                let urlHtml = '<span class="text-muted small">-</span>';
                if (item.url && String(item.url).trim() !== "" && String(item.url).trim() !== "-") {
                    const urls = String(item.url).split('\n');
                    urlHtml = urls.map(u => {
                        if(!u.trim()) return '';
                        return `<a href="${u.trim()}" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-1 me-1" title="เปิดดูหลักฐาน">
                                    <i class="bi bi-file-earmark-text"></i>
