    return `${d.getDate()}/${d.getMonth() + 1}/${d.getFullYear()}`;
}

/** ฟังก์ชันแปลงเงินบาทไทย - ฉบับแก้ไข */
function ArabicToThaiBaht(numbers) {
    if (isNaN(numbers) || numbers === null) return "ศูนย์บาทถ้วน";
    
    var number = parseFloat(numbers).toFixed(2);
    var bahtText = "";
    var unit = ["", "สิบ", "ร้อย", "พัน", "หมื่น", "แสน", "ล้าน"];
    var numberText = ["ศูนย์", "หนึ่ง", "สอง", "สาม", "สี่", "ห้า", "หก", "เจ็ด", "แปด", "เก้า"];
    var splitNumber = number.split(".");
    var baht = splitNumber[0];
    var satang = splitNumber[1];

    function convert(numStr) {
        var text = "";
        var len = numStr.length;
        for (var i = 0; i < len; i++) {
            var n = numStr.substr(i, 1);
            var pos = len - i - 1; // ตำแหน่งหลัก (0=หน่วย, 1=สิบ...)

            if (n != "0") {
                // จัดการคำว่า "ล้าน" (จะใส่เมื่อครบรอบ 6 หลัก และไม่ใช่หลักหน่วยสุดท้าย)
                if (pos % 6 == 0 && pos > 0) { 
                    // ใส่ "ล้าน" เฉพาะตำแหน่งที่หาร 6 ลงตัวและไม่ใช่หลักหน่วย
                }

                // จัดการเลข 1 ในหลักหน่วย (เอ็ด)
                if (n == "1" && pos % 6 == 0 && i != 0) {
                    text += "เอ็ด";
                }
                // จัดการเลข 2 ในหลักสิบ (ยี่)
                else if (n == "2" && pos % 6 == 1) {
                    text += "ยี่";
                }
                // จัดการเลข 1 ในหลักสิบ (สิบ เฉยๆ ไม่ใช่ หนึ่งสิบ)
                else if (n == "1" && pos % 6 == 1) {
                    text += ""; 
                }
                else {
                    text += numberText[n];
                }
                
                text += unit[pos % 6];
            }
            
            // เติมคำว่า "ล้าน" เมื่อครบรอบทุก 6 หลัก
            if (pos % 6 == 0 && pos > 0) {
                text += "ล้าน";
            }
        }
        return text;
    }

    if (parseInt(baht) == 0) { 
        bahtText = "ศูนย์บาท"; 
    } else { 
        bahtText = convert(baht) + "บาท"; 
    }

    if (satang == "00" || parseInt(satang) == 0) { 
        bahtText += "ถ้วน"; 
    } else { 
        bahtText += convert(satang) + "สตางค์"; 
    }

    return bahtText;
}
