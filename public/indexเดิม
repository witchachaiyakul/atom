        }
        btn.disabled = false;
        btn.innerHTML = 'ยืนยันการบันทึกการจ่าย (Paid)';
      })
      // 🚀 เรียกฟังก์ชันหลังบ้าน พร้อมแนบพารามิเตอร์ข้อมูลผู้ใช้งาน (currentUserObj) ปิดท้ายเป็นตัวที่ 2 สำเร็จ!
      .savePaymentTransaction({
        docIds: selectedPaymentRows.map(i => i.docId),
        slip: slipData,
        receipt: receiptData,
        namingInfo: namingInfo,
        pay_ch: payCh,
        pay_day: payDay
      }, currentUserObj); 

  } catch (e) {
    console.error(e);
    // --- ส่วนแจ้งเตือนเมื่อระบบขัดข้อง (Catch Error Pop-up) ---
    if (typeof Swal !== 'undefined') {
