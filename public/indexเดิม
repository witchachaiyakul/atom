// 2. ฟังก์ชันกลับหน้าหลัก (resetFormToMain)
// ==========================================
function resetFormToMain() {
  console.log("--- เริ่มการสั่งการ Reset กลับหน้าหลัก ---");

  try {
    // 1. ซ่อนหน้ากาก Loading (ใช้การซ่อนแทนการ remove DOM)
    const overlay = document.getElementById('loadingOverlay');
    if (overlay) {
      overlay.style.display = 'none';
      overlay.classList.add('d-none');
    }

    // 2. ปิด Modal ทุกตัวผ่าน Bootstrap Instance
    if (typeof bootstrap !== 'undefined') {
      const modalEls = document.querySelectorAll('.modal.show');
      modalEls.forEach(m => {
        const inst = bootstrap.Modal.getInstance(m);
        if (inst) inst.hide();
      });
    }

    // 3. เคลียร์ Modal Backdrop และคืนค่า Body Scroll (กรณีมี Backdrop ค้าง)
    const backdrops = document.getElementsByClassName('modal-backdrop');
    while (backdrops[0]) { 
      backdrops[0].parentNode.removeChild(backdrops[0]); 
    }
    document.body.classList.remove('modal-open');
    document.body.style.overflow = '';
    document.body.style.paddingRight = '';

    // 4. บังคับซ่อนทุกหน้าจอ
    const sections = [
      'mainDashboard', 'expenseEntry', 'updateForm', 'paymentRecord', 
      'summaryDashboard', 'incomeSection', 'incomeEditSection', 'incomeForm', 'cashoutForm', 
      'paymentSection', 'invoiceBulkSection', 'searchInvoiceSection', 'expenseForm2', 
      'summarySection', 'expenseSummarySection', 'financialReportSection', 'PurchesOrderSection',
      'AuditCashoutSection' // 🟢 รวม Section ใหม่แล้ว
    ];

    sections.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.classList.add('d-none');
        el.style.display = 'none';
      }
    });

    // 5. แสดงหน้า Dashboard หลัก
    const main = document.getElementById('mainDashboard');
    if (main) {
      main.classList.remove('d-none');
      main.style.display = 'block';
      console.log("แสดงหน้า Dashboard สำเร็จ");
    } else {
      alert("หา Element ID 'mainDashboard' ไม่เจอ");
    }

  } catch (err) {
    console.error("เกิดข้อผิดพลาดในการ Reset:", err);
  }
}
