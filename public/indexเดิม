// ==========================================
// UI Help
// ==========================================
function showLoading(m) { const div = document.createElement('div'); div.id = 'loadingOverlay'; div.style = "position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.85); z-index: 10000; display: flex; flex-direction: column; align-items: center; justify-content: center;"; div.innerHTML = `<div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div><div class="mt-3 fw-bold text-primary">${m}</div>`; document.body.appendChild(div); }

function hideLoading() {
      // 1. ค้นหาทุกอย่างที่มี ID หรือ Class เกี่ยวกับ Loading (ใช้ querySelectorAll)
      const loaders = document.querySelectorAll('#loadingOverlay, .loading-screen, .modal-backdrop');
  
      // 2. วนลูปสั่งลบทิ้งทุกตัวที่ขวางหน้า
            loaders.forEach(el => {
            if (el) el.remove(); 
       });

  // 3. ปลดล็อกตัว Body (ป้องกันกรณีหน้าจอค้างแล้วไถขึ้นลงไม่ได้)
  document.body.style.overflow = 'auto';
  console.log("สั่งปิด Loading ทุกชั้นเรียบร้อย");
}

function showToast(m, t) { const container = document.getElementById('toastContainer'); const toast = document.createElement('div'); toast.className = `custom-toast toast-${t}`; toast.innerHTML = `<i class="bi ${t === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'}"></i> <span>${m}</span>`; container.appendChild(toast); setTimeout(() => toast.classList.add('show'), 100); setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 3000); }

function addNew(t) { 
  const val = prompt("ป้อนข้อมูลใหม่:"); 
  
  // 🛑 1. ดักจับ: ถ้าคนกด Cancel หรือไม่ได้พิมพ์อะไรเลย ให้ตัดจบระบบทันที ไม่ต้องส่งไปหลังบ้าน
  if (!val || !val.trim()) return; 

  // 🔍 2. ดึงโปรไฟล์พนักงานที่แอบจำไว้ใน sessionStorage ออกมา
  const storedUser = sessionStorage.getItem("current_user");
  const currentUserObj = storedUser ? JSON.parse(storedUser) : null;

  // 🚀 3. สั่งยิงส่งไปหลังบ้าน (สอดพารามิเตอร์ t และ val ตัวจริงของพี่ พร้อมแนบโปรไฟล์คนกด)
  google.script.run
    .withSuccessHandler(loadDropdowns) // 🎯 ใช้ฟังก์ชันดึงค่า Dropdown ใหม่ตัวเดิมของพี่วิชชา
    .addNewOption(t, val.trim(), currentUserObj); 
}

