function openCashoutDetail(docId) {
  activeDocId = docId;
  if (typeof showLoading === 'function') showLoading("กำลังดึงรายการบิลประจำวัน...");
  
  google.script.run
    .withSuccessHandler((billsData) => {
      if (typeof hideLoading === 'function') hideLoading();
      currentDayBillsData = billsData; 
      renderIntermediateBillsList(docId);
    })
    .withFailureHandler((err) => {
      if (typeof hideLoading === 'function') hideLoading();
      alert("ผิดพลาด: " + err.message);
    })
    .getCashoutItems(docId);
}

