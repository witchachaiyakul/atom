function openSearchInvoice(mode = 'unpaid') {
    console.log("--- [LOG] เริ่มทำงาน openSearchInvoice โหมด:", mode);
    
    // 1. บังคับแสดงหน้าจอทันที
    showForm('searchInvoiceSection');
    
    // ตั้งค่าปุ่ม Radio ให้ตรงกับโหมดที่กดเข้ามา (ค้างจ่าย/จ่ายแล้ว)
    if (mode === 'paid') {
        const btnPaid = document.getElementById('statusPaid');
        if (btnPaid) btnPaid.checked = true;
    } else {
        const btnUnpaid = document.getElementById('statusUnpaid');
        if (btnUnpaid) btnUnpaid.checked = true;
    }

    // 2. เคลียร์ค่า Filter ตัวอักษรและวันที่
    const filters = ['filterDate', 'filterSupplier', 'filterShop', 'filterInvNo', 'filterAmount'];
    filters.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
    });

    // 3. ล้างตารางเดิมและแสดงสถานะ
    const tbody = document.getElementById('invoiceResultBody');
    if (tbody) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-5"><div class="spinner-border text-primary"></div><br>กำลังดึงข้อมูล...</td></tr>';
    }

    if (typeof showLoading === 'function') showLoading(mode === 'paid' ? "กำลังโหลดรายการที่จ่ายแล้ว..." : "กำลังโหลดรายการค้างจ่าย...");

    console.log("--- [LOG] กำลังส่งคำขอไปที่ Server พร้อมโหมด:", mode);

    google.script.run
        .withSuccessHandler(data => {
            console.log("--- [LOG] ได้รับข้อมูลจาก Server:", data ? data.length : 0, "รายการ ---");
            allInvoiceData = data || []; 
            
            // วาดตาราง
            displayInvoices(allInvoiceData); 
            
            // สั่งกรองข้อมูลทันทีเพื่อให้แสดงผลตามโหมด (Paid/Unpaid) ที่เลือก
            filterInvoices();
            
            if (typeof hideLoading === 'function') hideLoading();
        })
        .withFailureHandler(err => {
            if (typeof hideLoading === 'function') hideLoading();
            alert("ไม่สามารถโหลดข้อมูลได้: " + err);
        })
        .getAllInvoicesForSearch(mode); // *** แก้ไข: ส่ง mode ไปเพื่อให้ Server Query ข้อมูลใหม่เฉพาะกลุ่มนั้นๆ ***
}

/** 1. แสดงผลรายการ Invoice (เพิ่ม data-ispaid เพื่อใช้แยกสถานะ) */
function displayInvoices(data) {
    const tbody = document.getElementById('invoiceResultBody');
    if (!tbody) return;

    if (!data || data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-5 text-muted">ไม่พบข้อมูลที่ต้องการค้นหา</td></tr>';
        return;
    }

    let allRowsHTML = data.map(item => {
        const amountValue = parseFloat(item.amount) || 0;
        
        // ตรวจสอบสถานะการจ่าย เพื่อเก็บไว้ใน Attribute ของแถว
        const isPaidStatus = (item.isPaid === true || item.isPaid === "true") ? "paid" : "unpaid";

        const id = item.docId; 
        const dNo = item.no || '-'; 
        const dDate = item.dateRaw || ""; 
        const dSupplier = (item.supplier || "").toLowerCase();
        const dShop = (item.shop || "").toLowerCase();
        const dInvNo = (item.invNo || "").toLowerCase();
        const dAmount = amountValue.toString();

        return `
            <tr class="invoice-row" 
                data-date="${dDate}" 
                data-supplier="${dSupplier}" 
                data-shop="${dShop}" 
                data-invno="${dInvNo}" 
                data-amount="${dAmount}"
                data-ispaid="${isPaidStatus}"> <td><span class="badge bg-secondary">${dNo}</span></td>
                <td>${item.date || '-'}</td>
                <td>${item.supplier || '-'}</td>
                <td>${item.shop || '-'}</td>
                <td>${item.invNo || '-'}</td>
                <td class="text-end fw-bold">${amountValue.toLocaleString(undefined, {minimumFractionDigits: 2})}</td>
                <td class="text-center">
                    <button class="btn btn-sm btn-outline-primary" onclick="prepareEditInvoice('${id}')">
                        <i class="bi bi-pencil"></i> แก้ไข
                    </button>
                </td>
            </tr>`;
    }).join('');

    tbody.innerHTML = allRowsHTML;
}

/** 2. ฟังก์ชันกรองข้อมูล (เพิ่มการตรวจสอบปุ่ม จ่ายแล้ว/ค้างจ่าย) */
function filterInvoices() {
    // 1. ดึงค่าจากปุ่ม Radio และช่อง Input ค้นหา
    const statusRadio = document.querySelector('input[name="statusFilter"]:checked');
    const fStatus = statusRadio ? statusRadio.value : 'unpaid'; // 'paid' หรือ 'unpaid'
    
    const fDate = document.getElementById('filterDate').value; 
    const fSupplier = document.getElementById('filterSupplier').value.toLowerCase().trim();
    const fShop = document.getElementById('filterShop').value.toLowerCase().trim();
    const fInvNo = document.getElementById('filterInvNo').value.toLowerCase().trim();
    const fAmount = document.getElementById('filterAmount').value.trim();

    // 2. ดึงทุกแถวใน tbody (เลือกเฉพาะ tr ที่เป็นข้อมูล invoice)
    const rows = document.querySelectorAll('#invoiceResultBody tr.invoice-row');

    rows.forEach(row => {
        // ดึงค่าจาก Attribute (ตรวจสอบให้มั่นใจว่าใน displayInvoices มีการ set data-ispaid ไว้)
        const tStatus = row.getAttribute('data-ispaid'); 
        const tDate = row.getAttribute('data-date') || ""; 
        const tSupplier = row.getAttribute('data-supplier') || "";
        const tShop = row.getAttribute('data-shop') || "";
        const tInvNo = row.getAttribute('data-invno') || "";
        const tAmount = row.getAttribute('data-amount') || "";

        // 3. ตรวจสอบเงื่อนไข
        // เงื่อนไขสถานะ (Paid/Unpaid)
        const matchStatus = (tStatus === fStatus);
        
        // เงื่อนไขวันที่และ Supplier
        const matchDate = fDate === "" || tDate.includes(fDate);
        const matchSupplier = fSupplier === "" || tSupplier.includes(fSupplier);
        
        // เงื่อนไขร้าน (Logic พิเศษสำหรับ "atom")
        let matchShop = false;
        if (fShop === "") {
            matchShop = true; 
        } else if (fShop === "atom") {
            matchShop = (tShop === "atom");
        } else {
            matchShop = tShop.includes(fShop);
        }

        // เงื่อนไขเลขใบเสร็จและจำนวนเงิน
        const matchInvNo = fInvNo === "" || tInvNo.includes(fInvNo);
        const matchAmount = fAmount === "" || tAmount.includes(fAmount);

        // 4. สั่งแสดงหรือซ่อนแถว (เงื่อนไขทั้งหมดต้องเป็นจริง)
        if (matchStatus && matchDate && matchSupplier && matchShop && matchInvNo && matchAmount) {
            row.style.display = "";
        } else {
            row.style.display = "none";
        }
    });
}

/** ล้างค่าการค้นหาทั้งหมด */
function clearInvoiceFilter() {
    const filters = ['filterDate', 'filterSupplier', 'filterShop', 'filterInvNo', 'filterAmount'];
    filters.forEach(id => document.getElementById(id).value = "");
    filterInvoices();
}

/** เตรียมข้อมูลสำหรับแก้ไข (เวอร์ชันแยก Receipt / Slip) */
function prepareEditInvoice(docId) {
    // ค้นหาข้อมูลด้วย docId
    const item = allInvoiceData.find(i => i.docId === docId);
    if (!item) {
        alert("ไม่พบข้อมูลรายการนี้ในฐานข้อมูล");
        return;
    }

    // เก็บค่า docId ไว้ใน input hidden
    const hiddenInput = document.getElementById('editRowNum'); 
    if(hiddenInput) hiddenInput.value = item.docId;

    document.getElementById('editDocNoDisplay').innerText = item.no || 'รายการใหม่';
    document.getElementById('editDate').value = item.dateRaw || ""; 
    document.getElementById('editDescription').value = item.description || "";
    document.getElementById('editSupplier').value = item.supplier || "";
    document.getElementById('editShop').value = item.shop || "";
    document.getElementById('editInvNo').value = item.invNo || "";
    document.getElementById('editAmount').value = item.amount || 0;

    // ข้อมูลสถานะ (ตรวจสอบค่า string "true"/"false" จาก Firestore)
    document.getElementById('editIsSet').checked = (item.isSet === true || item.isSet === "true");
    document.getElementById('editPayChannel').value = item.payChannel || "";
    document.getElementById('editPayDate').value = item.payDateRaw || "";
    document.getElementById('editIsPaid').checked = (item.isPaid === true || item.isPaid === "true");

    // 🎯 [กล่องเรนเดอร์ที่ 1 คงเดิมครบ]: จัดการการแสดงผลหลายไฟล์ (URL จาก Firestore)
    const urlArea = document.getElementById('urlDisplayArea');
    if (urlArea) {
        if (item.invoiceUrl) {
            const urls = item.invoiceUrl.toString().split(/[\n,]+/);
            let html = '<div class="d-flex flex-wrap justify-content-center gap-2">';
            urls.forEach((url, index) => {
                const cleanUrl = url.trim();
                if (cleanUrl) {
                    html += `
                        <a href="${cleanUrl}" target="_blank" class="btn btn-sm btn-outline-primary shadow-sm">
                            <i class="bi bi-file-earmark-text"></i> ไฟล์ที่ ${index + 1}
                        </a>`;
                }
            });
            html += '</div>';
            urlArea.innerHTML = html;
        } else {
            urlArea.innerHTML = `<span class="text-muted small">ไม่มีไฟล์แนบเดิม</span>`;
        }
    }

    // 🎯 [กล่องเรนเดอร์ที่ 2 เพิ่มขยาย]: แสดงผลลิงก์ใบเสร็จ (receipt)
    const receiptArea = document.getElementById('receiptUrlDisplayArea');
    if (receiptArea) {
        if (item.receipt && item.receipt !== "-") {
            receiptArea.innerHTML = `<a href="${item.receipt.trim()}" target="_blank" class="btn btn-sm btn-outline-primary fw-bold w-100 py-1"><i class="bi bi-eye-fill"></i> 👁️ ดูใบเสร็จแยก</a>`;
        } else {
            receiptArea.innerHTML = `<span class="text-muted small">ไม่มีไฟล์ใบเสร็จแยก</span>`;
        }
    }

    // 🎯 [กล่องเรนเดอร์ที่ 3 เพิ่มขยาย]: แสดงผลลิงก์สลิปเงินโอน (slip)
    const slipArea = document.getElementById('slipUrlDisplayArea');
    if (slipArea) {
        if (item.slip && item.slip !== "-") {
            slipArea.innerHTML = `<a href="${item.slip.trim()}" target="_blank" class="btn btn-sm btn-outline-success fw-bold w-100 py-1"><i class="bi bi-file-earmark-image"></i> 🟢 ดูสลิปแยก</a>`;
        } else {
            slipArea.innerHTML = `<span class="text-muted small">ไม่มีไฟล์สลิปแยก</span>`;
        }
    }

    // ล้างอินพุตอัปโหลดรูปให้สะอาดสะอ้าน
    if (document.getElementById('editFileInput')) document.getElementById('editFileInput').value = "";
    if (document.getElementById('editReceiptInput')) document.getElementById('editReceiptInput').value = "";
    if (document.getElementById('editSlipInput')) document.getElementById('editSlipInput').value = "";

    const editModal = new bootstrap.Modal(document.getElementById('editInvoiceModal'));
    editModal.show();
}

/** 6. ฟังก์ชันช่วยแปลงวันที่ */
function formatDateForInput(dateStr) {
    if (!dateStr) return '';
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return '';
    const month = '' + (d.getMonth() + 1);
    const day = '' + d.getDate();
    const year = d.getFullYear();
    return [year, month.padStart(2, '0'), day.padStart(2, '0')].join('-');
}

async function saveEditInvoice() {
    const fileInput = document.getElementById('editFileInput');
    let fileDataArray = [];

    if (typeof showLoading === 'function') showLoading("กำลังอัปเดตข้อมูล...");

    try {
        // 🎯 [ตัวอ่านไฟล์ที่ 1 ของเดิมคงไว้]: วนอ่านอัปโหลดไฟล์รวมแบบ array ของพี่วิชชา
        if (fileInput && fileInput.files.length > 0) {
            const files = Array.from(fileInput.files);
            fileDataArray = await Promise.all(files.map(file => {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = (e) => resolve({
                        base64: e.target.result.split(',')[1],
                        mimeType: file.type,
                        fileName: file.name
                    });
                    reader.onerror = reject;
                    reader.readAsDataURL(file);
                });
            }));
        }

        // ฟังก์ชันช่วยย่อยอ่านไฟล์เดี่ยวสำหรับกล่องอัปโหลดใบเสร็จและสลิปใหม่
        const readSingleFile = (inputId) => {
            const input = document.getElementById(inputId);
            return new Promise((resolve) => {
                if (!input || !input.files || input.files.length === 0) return resolve(null);
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = (e) => resolve({
                    base64: e.target.result.split(',')[1],
                    mimeType: file.type,
                    fileName: file.name
                });
                reader.onerror = () => resolve(null);
                reader.readAsDataURL(file);
            });
        };

        // 🎯 [ตัวอ่านไฟล์ที่ 2 และ 3 เขียนขยาย]: อ่านไฟล์ช่อง receipt และ slip
        const [receiptFile, slipFile] = await Promise.all([
            readSingleFile('editReceiptInput'),
            readSingleFile('editSlipInput')
        ]);

        const payload = {
            docId: document.getElementById('editRowNum').value, 
            date: document.getElementById('editDate').value,
            list: document.getElementById('editDescription').value, 
            supplier: document.getElementById('editSupplier').value,
            shop: document.getElementById('editShop').value,
            invoice_no: document.getElementById('editInvNo').value, 
            net_amount: document.getElementById('editAmount').value,
            clam_sub: document.getElementById('editIsSet').checked ? "true" : "false",
            pay_ch: document.getElementById('editPayChannel').value,
            pay_day: document.getElementById('editPayDate').value,
            paid: document.getElementById('editIsPaid').checked ? "true" : "false",
            
            // แพ็กส่งก้อนข้อมูลออกไปครบทุกท่อพร้อมกัน
            fileData: fileDataArray,
            receiptFileData: receiptFile,
            slipFileData: slipFile
        };

        // 🔍 เจาะดึงก้อนโปรไฟล์พนักงานที่แอบจำไว้ใน sessionStorage ออกมาเตรียมส่งให้หลังบ้าน
        const storedUser = sessionStorage.getItem("current_user");
        const currentUserObj = storedUser ? JSON.parse(storedUser) : null;

        google.script.run
            .withSuccessHandler(res => {
                if (typeof hideLoading === 'function') hideLoading();
                bootstrap.Modal.getInstance(document.getElementById('editInvoiceModal')).hide();
                if (typeof showToast === 'function') showToast("อัปเดตสำเร็จ", "success");
                openSearchInvoice(); // โหลดข้อมูลใหม่
            })
            .withFailureHandler(err => {
                if (typeof hideLoading === 'function') hideLoading();
                alert("บันทึกไม่สำเร็จ: " + err);
            })
            // 🎯 [แก้ไขจุดสำคัญ]: ใส่พ่วง currentUserObj ปิดท้ายวงเล็บตรงนี้ เพื่อยิงข้อมูลตัวตนพนักงานไปหลังบ้านคู่กับ payload ครับ
            .updateInvoiceFull(payload, currentUserObj);

    } catch (error) {
        if (typeof hideLoading === 'function') hideLoading();
        alert("ข้อผิดพลาด: " + error.message);
    }
}

