      allowOutsideClick: false,
      showConfirmButton: false,
      didOpen: () => { Swal.showLoading(); }
    });
  }

  try {
    const firstItem = selectedPaymentRows[0];
    const totalAmount = selectedPaymentRows.reduce((sum, row) => sum + parseFloat(row.amount || 0), 0);

    const namingInfo = {
      doc_no: firstItem.ref || 'EXP',
      supplier: firstItem.supplier || 'Unknown',
      total_amount: totalAmount.toFixed(2)
    };

    let slipData = slipFile ? await fileToByteArray(slipFile) : null;
    let receiptData = receiptFile ? await fileToByteArray(receiptFile) : null;

    // 🔍 เจาะดึงก้อนโปรไฟล์พนักงานที่แอบจำไว้ใน sessionStorage ออกมาเตรียมส่งให้หลังบ้าน
    const storedUser = sessionStorage.getItem("current_user");
    const currentUserObj = storedUser ? JSON.parse(storedUser) : null;

    google.script.run
      .withSuccessHandler((res) => {
        // --- ส่วนแจ้งเตือนเมื่อสำเร็จ (Success Pop-up) ---
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            icon: 'success',
            title: 'สำเร็จ',
            text: 'บันทึกการจ่ายและอัปโหลดหลักฐานเรียบร้อย',
