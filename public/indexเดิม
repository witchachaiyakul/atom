  function calculateUpdateVAT() {
  const amt = parseFloat(document.getElementById('updateAmount').value) || 0;
  const type = document.getElementById('updateVatType').value;
  let b = 0, v = 0, t = 0;

  if (type === 'invat') {
    b = amt * 100 / 107; v = amt * 7 / 107; t = amt;
  } else if (type === 'exvat') {
    b = amt; v = amt * 0.07; t = amt + v;
  } else {
    b = amt; v = 0; t = amt;
  }

  document.getElementById('updateBeforeVat').innerText = b.toFixed(2);
  document.getElementById('updateVatAmount').innerText = v.toFixed(2);
  document.getElementById('updateTotal').innerText = t.toFixed(2);
}

