  <script>
  const currentUser = <?!= JSON.stringify(lineUser) ?>;  
  console.log("=== ตรวจสอบข้อมูลสิทธิ์จากหลังบ้าน ===");
  console.log(currentUser);
  document.addEventListener("DOMContentLoaded", function() {
    if (currentUser) {
      const nameEl = document.getElementById("headerUserName");
      const imgEl = document.getElementById("headerUserImg");
      const profileBox = document.getElementById("userHeaderProfile");

      if (nameEl) nameEl.innerText = currentUser.name || "ไม่ระบุชื่อ";
      if (imgEl) imgEl.src = currentUser.picture || "https://cdn-icons-png.flaticon.com/512/149/149071.png";
      if (profileBox) profileBox.style.setProperty("display", "flex", "important");
      
      // 3. เริ่มประมวลผลคัดกรองสิทธิ์หน้าจอ
      checkDashboardPermissions();
    }
  });

  function checkDashboardPermissions() {
  // 🔒 เพิ่มตัวป้องกัน (Safe Guard): ป้องกันโค้ดพังเงียบ หากหน้าบ้านยังดึงสิทธิ์มาไม่สำเร็จ หรือค่า allowedOptions เป็น undefined
  if (!currentUser || !currentUser.allowedOptions) {
    console.warn("⚠️ ไม่สามารถรันระบบกรองสิทธิ์ได้ เนื่องจากไม่พบข้อมูล allowedOptions");
    return; 
  }

  // 💡 เคสพิเศษ: สิทธิ์สูงสุด (admin) หรือมีคีย์ "ALL" ให้ปลดล็อกทุกเมนู
  if (currentUser.role === "admin" || currentUser.allowedOptions.includes("ALL")) {
    const costMenu = document.querySelector("div[onclick=\"showForm('costAnalysisSection')\"]");
    if (costMenu && costMenu.parentElement) {
      costMenu.parentElement.classList.remove("d-none");
    }
    return; 
  }
  
  // 💡 เคสปกติ: จับคู่ฟังก์ชันปุ่มกดกับคีย์สิทธิ์
  const menuMapping = [
    { action: "showForm('expenseEntry')",          key: "ExpenseEntry" },
    { action: "showForm('expenseForm2')",          key: "ExpenseForm2" },
    { action: "showForm('paymentRecord')",         key: "PaymentRecord" },
    { action: "openSearchInvoice()",              key: "SearchInvoice" },
    { action: "openIncomeMenu()",                 key: "IncomeMenu" },
    { action: "openCashout()",                    key: "Cashout" },
    { action: "openSummary()",                    key: "SummarySales" },
    { action: "showForm('expenseSummarySection')", key: "SummaryCashout" },
    { action: "showForm('financialReportSection')",key: "FinancialReport" }
  ];

  // วนลูปตรวจสอบ: ถ้าไม่มีชื่อสิทธิ์อยู่ใน allowedOptions ให้สั่งซ่อนการ์ดเมนูนั้นทันที
  menuMapping.forEach(menu => {
    if (!currentUser.allowedOptions.includes(menu.key)) {
      hideMenuElement(menu.action);
    }
  });
}

  function hideMenuElement(onclickString) {
    const targetCard = document.querySelector(`div[onclick="${onclickString}"]`);
    if (targetCard && targetCard.parentElement) {
      targetCard.parentElement.style.display = "none"; 
    }
  }

    const originalShowForm = window.showForm; 
      window.showForm = function(formId) {
      if (!currentUser || !currentUser.allowedOptions) return;
    
    const secureForms = {
      'financialReportSection': 'FinancialReport',
      'expenseSummarySection': 'SummaryCashout',
      'costAnalysisSection': 'ALL'
    };

    const requiredKey = secureForms[formId];
    
    if (requiredKey && currentUser.role !== "admin" && !currentUser.allowedOptions.includes("ALL")) {
      if (!currentUser.allowedOptions.includes(requiredKey)) {
        alert("⚠️ ขออภัยครับ บัญชีของคุณไม่มีสิทธิ์เข้าใช้งานฟังก์ชันส่วนนี้");
        return; 
      }
    }
    
    if (typeof originalShowForm === "function") {
      originalShowForm(formId);
    }
  };
</script>

