function submitUpdate() {
  const inv = document.getElementById('invNo').value;
  const amt = document.getElementById('updateAmount').value; // ยอดเงินที่อาจถูกแก้ไข
  const file = document.getElementById('invFile').files[0];

  if (!inv || !amt) return showToast("ระบุเลขใบเสร็จและจำนวนเงิน", "error");

  showLoading('กำลังบันทึก...');

  // เตรียมข้อมูลส่งไปที่ Code.gs
  const payload = {
    rowNum: currentItem.rowNum,
    no: currentItem.no,
    invNo: inv,
    amount: amt,
    vatType: document.getElementById('updateVatType').value,
    // ค่าเหล่านี้คำนวณจากหน้าจอส่งไป
    beforeVat: document.getElementById('updateBeforeVat').innerText,
    vatAmount: document.getElementById('updateVatAmount').innerText,
    total: document.getElementById('updateTotal').innerText
  };

  const reader = new FileReader();
  reader.onload = (e) => {
    payload.fileData = e.target.result;
    google.script.run.withSuccessHandler(() => { 
      hideLoading(); 
      showToast("อัพเดทสำเร็จ"); 
      openUpdateMenu(); // โหลดรายการใหม่
    }).updateInvoiceData(payload);
  };

  if (file) {
    reader.readAsDataURL(file);
  } else {
    payload.fileData = null;
    google.script.run.withSuccessHandler(() => { 
      hideLoading(); 
      showToast("อัพเดทสำเร็จ (ไม่มีไฟล์)"); 
      openUpdateMenu(); 
    }).updateInvoiceData(payload);
  }
}

