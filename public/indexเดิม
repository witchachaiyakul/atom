/**
 * 📅 ปรับรูปแบบวันที่จากระบบสแกนภาษาอังกฤษยาวๆ ให้เหลือเฉพาะ dd/mm/yyyy
 * @param {string} dateStr ตัวแปรวันที่ดิบ เช่น "Sat Nov 01 2025 00:00:00 GMT+0700"
 */
function cleanDateToDMY(dateStr) {
  if (!dateStr || dateStr === '-') return '-';
  
  try {
    const d = new Date(dateStr);
    
    // ตรวจสอบเผื่อกรณีตัวแปรไม่ใช่ฟอร์แมตวันที่จริง (Invalid Date)
    if (isNaN(d.getTime())) return dateStr; 
    
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0'); // เดือนใน JS เริ่มนับจาก 0 จึงต้อง +1
    const year = d.getFullYear();
    
    return `${day}/${month}/${year}`;
  } catch (e) {
    console.warn("⚠️ ไม่สามารถแปลงฟอร์แมตวันที่ระบุได้:", e.message);
    return dateStr; // หากระบบแกะคำพลาด ให้คืนค่าข้อความเดิมเพื่อไม่ให้หน้าจอค้าง
  }
}

