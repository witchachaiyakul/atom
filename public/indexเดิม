function calculateGrandTotal() {
  let total = 0;
  
  // 1. ดึงค่าจากทุกแถวที่มี class 'row-amount' (ถ้ามี)
  const rows = document.querySelectorAll('.row-amount');
  rows.forEach(i => total += parseFloat(i.value) || 0);

  // 2. [จุดที่ต้องแก้] เช็คก่อนว่ามีที่แสดงผลไหม ถ้าไม่มีให้ข้ามไป ไม่ต้อง Crash
  const display = document.getElementById('totalDisplay'); 
  if (display) {
    display.innerText = total.toLocaleString(undefined, {minimumFractionDigits: 2});
  } else {
    // ถ้าหาไม่เจอ ให้ Log เตือนไว้ใน Console เฉยๆ จะได้ไม่หยุดทำงาน
    console.warn("ไม่พบไอดี 'totalDisplay' ในหน้า HTML สำหรับแสดงยอดรวม");
  }
}

