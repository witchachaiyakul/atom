/**
 * ฟังก์ชันคำนวณภาษีและยอดสุทธิรายแถว
 */
function updateRowCalc(id) {
  const row = document.getElementById(`row_container_${id}`);
  // ดึงยอดเงินจากช่อง จำนวนเงิน (Net)
  const amt = parseFloat(row.querySelector('.row-amount').value) || 0;
  // ดึงประเภทภาษี
  const vt = row.querySelector('.row-vat-type').value;
  
  let b = 0, v = 0, n = 0;
  if (vt === 'none') { 
    b = amt; v = 0; n = amt; 
  } else if (vt === 'invat') { 
    b = amt * 100 / 107; v = amt * 7 / 107; n = amt; 
  } else if (vt === 'exvat') { 
    b = amt; v = amt * 0.07; n = amt + v; 
  }

  // แสดงผลให้ตรงกับ ID ใน HTML ของคุณ [สำคัญมาก]
  document.getElementById(`row_beforeVat_${id}`).innerText = b.toFixed(2);
  document.getElementById(`row_vatAmount_${id}`).innerText = v.toFixed(2);
  document.getElementById(`row_netTotal_${id}`).innerText = n.toFixed(2);
  
  updateTotalDisplay();
}

/**
 * ฟังก์ชันคำนวณยอดรวมสุทธิทั้งสิ้น (Grand Total)
 */
function updateTotalDisplay() {
  // 1. ประกาศตัวแปรเริ่มต้น (ชื่อต้องตรงกับที่จะใช้ใน loop และการแสดงผล)
  let sumNoVat = 0;       // สำหรับช่อง 1. รวมยอดไม่มี Vat
  let sumBeforeVat = 0;   // สำหรับช่อง 2. รวมยอดมี Vat (ก่อน Vat)
  let sumVatAmount = 0;   // สำหรับช่อง 3. รวม Vat 7%
  let totalDisplaySum = 0; // สำหรับช่อง 4. ยอดรวมสุทธิทั้งสิ้น

  // 2. วนลูปทุกแถวรายการ
  document.querySelectorAll('.item-row-card').forEach(row => {
    // ดึง ID ของแถว (เช่น row_container_1 -> 1)
    const id = row.id.split('_').pop();
    
    // ดึงประเภทภาษีของแถวนั้นๆ
    const vatType = row.querySelector('.row-vat-type').value;
    
    // ดึงตัวเลขจาก Span (ต้องลบคอมม่าออกก่อน parseFloat)
    const getVal = (selectorId) => {
      const el = document.getElementById(selectorId);
      return el ? parseFloat(el.innerText.replace(/,/g, '')) || 0 : 0;
    };

    const b = getVal(`row_beforeVat_${id}`);   // ก่อน Vat
    const v = getVal(`row_vatAmount_${id}`);  // Vat 7%
    const n = getVal(`row_netTotal_${id}`);   // สุทธิ

    // 3. ตรรกะแยกประเภทภาษี (แก้ไขชื่อตัวแปรให้ตรงกัน)
    if (vatType === 'none') {
      sumNoVat += n;
    } else {
      sumBeforeVat += b;   // สะสมยอดก่อน VAT
      sumVatAmount += v;   // สะสมยอด VAT 7%
    }
    
    // ยอดรวมสุทธิรวมจากทุกบรรทัด
    totalDisplaySum += n;
  });

  // 4. ฟังก์ชันจัดรูปแบบตัวเลข (1,234.56)
  const format = (val) => val.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});

  // 5. แสดงผลลงใน ID ตาม HTML ของคุณ (ตรวจสอบ ID ให้เป๊ะ)
  if (document.getElementById('sumNoVat')) {
    document.getElementById('sumNoVat').innerText = format(sumNoVat);
  }
  if (document.getElementById('sumBeforeVat')) {
    document.getElementById('sumBeforeVat').innerText = format(sumBeforeVat);
  }
  if (document.getElementById('sumVatAmount')) {
    document.getElementById('sumVatAmount').innerText = format(sumVatAmount);
  }
  if (document.getElementById('totalDisplay')) {
    document.getElementById('totalDisplay').innerText = format(totalDisplaySum);
  }
}

