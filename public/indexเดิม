}

/** 3. ฟังก์ชันกรองข้อมูลบนหน้าจอเบราว์เซอร์ (Client-side Filter) */
function filterCashoutTable() {
  const fDate = document.getElementById('cashoutFilterDate') ? document.getElementById('cashoutFilterDate').value : '';
  const fShop = document.getElementById('cashoutFilterShop') ? document.getElementById('cashoutFilterShop').value : '';

  console.log("--- [Filter] เริ่มการคัดกรองด้วยเงื่อนไขรายวัน ---", { เลือกวันที่: fDate, เลือกร้าน: fShop });

  const filtered = (allCashouts || []).filter((i) => {
    const matchDate = fDate ? (i.dateRaw === fDate) : true;
    const matchShop = fShop ? (i.shop === fShop) : true;
    return matchDate && matchShop;
  });

  console.log("--- [Filter] ผลการกรองคงเหลือแสดงผล: " + filtered.length + " รายการ ---");
