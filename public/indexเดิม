function removePoItemRow(rowId) {
  const totalRows = document.querySelectorAll('#po-items-body tr').length;
  if (totalRows <= 1) {
    Swal.fire('แจ้งเตือน', 'ใบสั่งซื้อจำเป็นต้องมีรายการสินค้าอย่างน้อย 1 รายการครับ', 'warning');
    return;
  }
  const row = document.getElementById(rowId);
  if (row) row.remove();
}

function compilePoItemsData() {
  const rows = document.querySelectorAll('#po-items-body tr');
  const items = [];
  rows.forEach(row => {
    const nameVal = row.querySelector('.po-item-name').value.trim();
    if (nameVal) { // กรองเฉพาะแถวที่มีการกรอกชื่อสินค้าจริง
      items.push({
        shop: row.querySelector('.po-item-shop').value,
        name: nameVal,
        qty: parseFloat(row.querySelector('.po-item-qty').value) || 0,
        unit: row.querySelector('.po-item-unit').value.trim()
      });
    }
  });
  return items;
}

function getPoFormPayload() {
  const supplierValue = document.getElementById('po-supplier-input').value.trim();
  return {
    id: currentPoDocId,
    supplier_name: supplierValue,
    items: compilePoItemsData()
  };
}

function savePoDraft() {
  const payload = getPoFormPayload();

  if (!payload.supplier_name || payload.items.length === 0 || payload.items.some(i => !i.name || i.qty <= 0 || !i.unit)) {
    Swal.fire('ข้อมูลไม่สมบูรณ์', 'กรุณาระบุชื่อผู้จัดจำหน่าย และรายละเอียดสินค้าในตารางให้ครบทุกช่องก่อนบันทึกร่าง', 'warning');
    return;
  }

  payload.status = "draft";
  if (typeof showLoading === 'function') showLoading("กำลังบันทึกร่างลงคอลเลกชัน...");

  google.script.run
    .withSuccessHandler(res => {
      if (res.success) {
        currentPoDocId = res.id; 
        Swal.fire('บันทึกร่างสำเร็จ', 'ระบบเก็บข้อมูลฉบับร่างของคุณเรียบร้อยแล้ว', 'success');
      } else {
        Swal.fire('บันทึกขัดข้อง', res.error, 'error');
      }
      if (typeof hideLoading === 'function') hideLoading();
    })
    .withFailureHandler(err => {
      if (typeof hideLoading === 'function') hideLoading();
      Swal.fire('ล้มเหลว', err.message, 'error');
    })
    .savePurchaseOrderDraft(payload);
}

function switchPoToPreview() {
  const payload = getPoFormPayload();

  if (!payload.supplier_name || payload.items.length === 0 || payload.items.some(i => !i.name || i.qty <= 0 || !i.unit)) {
    Swal.fire('ฟอร์มไม่ครบถ้วน', 'กรุณากรอกข้อมูลผู้จำหน่ายและรายละเอียดสินค้าในตารางให้ถูกต้องก่อนตรวจสอบ', 'info');
    return;
  }

  if (typeof showLoading === 'function') showLoading("กำลังดึงรายละเอียดข้อมูลเอกสาร...");

  google.script.run
    .withSuccessHandler(supDetails => {
      if (typeof hideLoading === 'function') hideLoading();
      
      let supplierDisplayHtml = `<strong>${payload.supplier_name}</strong>`;
      if (supDetails && supDetails.supplier_tax_id !== "-") {
        supplierDisplayHtml += `<br><small class="text-muted">เลขผู้เสียภาษี: ${supDetails.supplier_tax_id}<br>ที่อยู่: ${supDetails.supplier_address}</small>`;
      }
      
      document.getElementById('preview-supplier').innerHTML = supplierDisplayHtml;
      document.getElementById('preview-date').innerText = document.getElementById('po-date-display').innerText.replace('วันที่: ', '');
      document.getElementById('preview-po-no').innerText = "รอคำนวณรันลำดับเลขที่ PO จากระบบ...";

      const previewBody = document.getElementById('po-preview-table-body');
      previewBody.innerHTML = '';
