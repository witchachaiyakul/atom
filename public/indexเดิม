// 🎯 ฟังก์ชันบันทึกข้อมูลหลัก (เวอร์ชันคํานวณสิทธิ์และ Path ส่งเข้า Firebase Storage)
async function submitAllData() {
  if (isProcessing) return;
  isProcessing = true;

  const invoiceItems = document.querySelectorAll('.invoice-item');
  const allData = [];
  
  console.log("--- เริ่มกระบวนการบันทึก: ตรวจพบ " + invoiceItems.length + " รายการ ---");
  if (typeof showLoading === 'function') showLoading("กำลังประมวลผลไฟล์และจัดระเบียบข้อมูล...");

  try {
    for (let index = 0; index < invoiceItems.length; index++) {
      const item = invoiceItems[index];
      console.log(`กำลังดึงข้อมูลรายการที่ ${index + 1}`);

      const data = {
        doc_no:       item.querySelector('.doc-no').value,        
        invoice_no:   item.querySelector('.doc-no').value,        
        doc_date:     item.querySelector('.doc-date').value, 
        shop:         item.querySelector('.shop-name').value,
        supplier:     item.querySelector('.supplier-name').value,
        net_amount:   Number(item.querySelector('.net-amount').value) || 0,
        total_amount: Number(item.querySelector('.net-amount').value) || 0,
        list:         item.querySelector('.item-type').value,     
        non_vat:      Number(item.querySelector('.exempt-amount').value.replace(/,/g, '')) || 0,
        ex_vat:       Number(item.querySelector('.base-price').value.replace(/,/g, '')) || 0,
        vat:          Number(item.querySelector('.vat-value').value.replace(/,/g, '')) || 0,
        vat_type:     item.querySelector('.vat-type:checked').value,
        status:       "done",
        url:          "" 
      };

      const fileInput = item.querySelector('.invoice-file');
      let uploadedUrls = [];

      if (fileInput && fileInput.files.length > 0) {
        console.log(`พบไฟล์ ${fileInput.files.length} ไฟล์ ในรายการของ ${data.supplier}`);
        
        // [แก้บั๊กวันที่] ป้องกันค่าวันที่พังหรือว่างเปล่า
        let rawDate = data.doc_date ? data.doc_date.trim() : "";
        if (!rawDate || rawDate === "-" || rawDate === "ไม่ระบุ") {
          rawDate = new Date().toISOString().split('T')[0]; 
        }

        const dateParts = rawDate.replace(/\//g, '-').split('-'); 
        let year = (dateParts[0] || "2026").trim();
        let month = (dateParts[1] || "01").trim().padStart(2, '0');
        let day = (dateParts[2] || "01").trim().padStart(2, '0');

        if (year.length !== 4 && day.length === 4) {
          const temp = year; year = day; day = temp;
        }

        const shopFolder = standardizeShopNameFrontend(data.shop);
        const invNo = data.invoice_no ? data.invoice_no.trim() : "NO-IV";

        for (let i = 0; i < fileInput.files.length; i++) {
          const file = fileInput.files[i];
          const ext = file.name.split('.').pop(); 
          
          if (typeof showLoading === 'function') {
            showLoading(`กำลังอัปโหลดไฟล์ของ ${data.supplier} (${i + 1}/${fileInput.files.length})...`);
          }

          const base64Data = await toBase64(file);

          const finalFileName = `${invNo}_${data.supplier}_${data.total_amount}_${i + 1}.${ext}`;
          const firebasePath = `invoice_library/${shopFolder}/${year}/${month}/${day}/${finalFileName}`;

          const fileUrl = await new Promise((resolve, reject) => {
            google.script.run
              .withSuccessHandler(res => {
                console.log("อัปโหลดเข้า Firebase สำเร็จไปที่: " + firebasePath);
                resolve(res);
              })
              .withFailureHandler(err => {
                console.error("อัปโหลดล้มเหลว: ", err);
                reject(err);
              })
              .uploadSingleFile(base64Data, file.type, firebasePath); 
          });
          uploadedUrls.push(fileUrl);
        }
      }
      data.url = uploadedUrls.join("\n");
      allData.push(data);
    }

    console.log("ส่ง Metadata ไป Firebase...", allData);
    if (typeof showLoading === 'function') showLoading("กำลังบันทึกข้อมูลลงระบบ...");

    // 🎯 [แก้ไขเพิ่มจุดสำคัญ]: เจาะดึงก้อนโปรไฟล์ผู้ใช้งานที่เซ็ตไว้ด้านบนสุด ออกมาเตรียมส่งให้หลังบ้าน
    const storedUser = sessionStorage.getItem("current_user");
    const currentUserObj = storedUser ? JSON.parse(storedUser) : null;

    google.script.run
      .withSuccessHandler(function(res) {
        isProcessing = false;
        if (typeof hideLoading === 'function') hideLoading();
        var modalElement = document.getElementById('successModal');
        if (modalElement) {
          var myModal = new bootstrap.Modal(modalElement);
          myModal.show();
        } else {
          alert('บันทึกข้อมูลสำเร็จเรียบร้อยแล้ว');
        }
      })
      .withFailureHandler(function(err) {
        isProcessing = false;
        if (typeof hideLoading === 'function') hideLoading();
        alert('เกิดข้อผิดพลาดจากระบบ: ' + err);
      })
      .saveInvoiceBulk(allData, currentUserObj); // 🎯 พ่วงส่ง currentUserObj ปิดท้ายเพื่อลงล็อกชื่อพนักงานคนกดจริงยิงเข้าคลาวด์

  } catch (error) {
    console.error("เกิด Error ใน submitAllData: ", error);
    isProcessing = false;
    if (typeof hideLoading === 'function') hideLoading();
    alert("เกิดข้อผิดพลาด: " + error.message);
  }
}

