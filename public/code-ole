  // ========================================================================
  const IS_DEV_MODE = false; 

  const scriptProperties = PropertiesService.getScriptProperties();
  const lineClientId = scriptProperties.getProperty('LINE_CHANNEL_ID');
  const lineClientSecret = scriptProperties.getProperty('LINE_CHANNEL_SECRET');
  
  // 🎯 [คงเดิม]: ดึงค่าคอนฟิก Firebase เว็บตัวเดิมของพี่มาสแตนด์บายไว้
  const webConfig = scriptProperties.getProperty('FIREBASE_WEB_CONFIG'); 
  
  // 🎯 [คงเดิม]: ดึงก้อน FIREBASE_KEY มาแกะแปรสภาพสดส่งหน้าบ้าน
  let webConfigCalculated = webConfig;
  if (!webConfigCalculated) {
    try {
      const firebaseKeyStr = scriptProperties.getProperty('FIREBASE_KEY');
      if (firebaseKeyStr) {
        const firebaseKeyJson = JSON.parse(firebaseKeyStr);
        const projectId = firebaseKeyJson.project_id;
        webConfigCalculated = JSON.stringify({
          projectId: projectId,
          authDomain: projectId + ".firebaseapp.com",
          databaseURL: "https://" + projectId + "-default-rtdb.firebaseio.com",
          storageBucket: projectId + ".appspot.com"
