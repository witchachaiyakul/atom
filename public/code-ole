  return finalBillsStructure;
}

function formatDateToISO(dateStr) {
  if (!dateStr) return "";
  const parts = dateStr.split('-');
  if (parts.length !== 3) return dateStr;
  const day = parts[0].padStart(2, '0');
  const month = parts[1].padStart(2, '0');
  const year = parts[2];
  return `${year}-${month}-${day}`;
}

/**
 * 🚀 บันทึกอัปเดตข้อมูลบิลทั้งหมดลง Firestore แบบ Batch Commit
 * (วางฟังก์ชันนี้ในไฟล์ Code.gs ชั้นนอกสุด)
 */
function saveAllDayBillsToFirestore(datePath, billsDataArray) {
  console.log("--- [START] saveAllDayBillsToFirestore (🚀 Batch Commit Mode) ---");
  if (!datePath || !billsDataArray || billsDataArray.length === 0) return "ไม่มีข้อมูลเพื่อบันทึก";

  const scriptProperties = PropertiesService.getScriptProperties();
  const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
  const projectId = keyFile.project_id;
  
  const dbPrefix = `projects/${projectId}/databases/(default)/documents`;
  const parentDocumentPath = `${dbPrefix}/cashout/${datePath}`; // พิกัดหลักของวันที่ เช่น Atom/days/2026-06-01
  const billsSubCollectionPath = `${parentDocumentPath}/bills`;  // คลังย่อยที่เก็บเอกสารบิลจริง

  const writes = [];

  try {
    // 📡 ดึงข้อมูลบิลดั้งเดิมบนคลาวด์มาก่อน เพื่อดึง Document ID จริง มาจับคู่เขียนทับ
    const response = callFirestore("GET", `cashout/${datePath}/bills`);
    
    if (response && response.documents && Array.isArray(response.documents)) {
      
      response.documents.forEach((doc, idx) => {
        const fullDocName = doc.name; // พาร์ทเต็มของบิลแต่ละใบใน Firestore
        const billFieldsRaw = doc.fields || {};
        
        // จับคู่ข้อมูลจากหน้าบ้านที่ส่งเรียงลำดับตาม index ตรงกัน
        const updatedBill = billsDataArray[idx];
        
        if (updatedBill) {
          // 🛠️ แปลงอาร์เรย์ items หน้าบ้านกลับไปเป็นฟอร์แมต Array ของ Map ใน Firestore
          const firestoreItemsValue = {
            arrayValue: {
              values: updatedBill.items.map(item => {
                return {
                  mapValue: {
                    fields: {
                      list: { stringValue: item.list || "ไม่มีชื่อรายการ" },
                      price: { doubleValue: Number(item.price) || 0 },
                      quantity: { doubleValue: Number(item.quantity) || 1 },
                      total: { doubleValue: Number(item.total) || 0 }
                    }
                  }
                };
              })
            }
          };

          // 🛠️ สร้าง Payload ชุดข้อมูลที่จะสั่งอัปเดต (🎯 เพิ่ม supplier เรียบร้อยแล้ว)
          const updatedFields = {
            ...billFieldsRaw, // แตกฟิลด์เดิมไว้ก่อนเพื่อไม่ให้ค่าอื่น ๆ หาย
            "supplier": { stringValue: updatedBill.supplier || "" }, // 🟢 [เพิ่มใหม่]: เซฟชื่อ Supplier
            "shop_bill": { stringValue: updatedBill.shopBill || "" },
            "category": { stringValue: updatedBill.category || "" },
            "bill_total": { doubleValue: Number(updatedBill.billTotal) || 0 },
            "items": firestoreItemsValue
          };

          // บรรจุเข้าแผนคำสั่ง Update เอกสารบิลใบนั้น ๆ
          writes.push({
            update: {
              name: fullDocName,
              fields: updatedFields
            },
            // 🎯 [เพิ่ม "supplier" ลงใน updateMask เพื่ออนุญาตให้เขียนทับฟิลด์ supplier ได้]
            updateMask: { fieldPaths: ["supplier", "shop_bill", "category", "bill_total", "items"] }
          });
        }
      });
    }

    // 🎯 2. สั่งแถมท้าย: เปลี่ยนสถานะเอกสาร Parent หลัก (ระนาบวันที่) ให้เป็น "done" ตรวจสอบแล้ว
    writes.push({
      update: {
        name: parentDocumentPath,
        fields: { "status": { "stringValue": "done" } }
      },
      updateMask: { fieldPaths: ["status"] }
    });

    // 🚀 ยิงชุดคำสั่งเซฟทั้งหมดขึ้นไปบน Firestore คลาวด์ในครั้งเดียว (Batch Commit)
    if (writes.length > 0) {
      const commitPayload = { writes: writes };
      callFirestore("POST", ":commit", commitPayload);
      console.log(`✅ บันทึก Batch Commit บิลจำนวน ${writes.length - 1} ใบ และอัปเดต Parent Status เรียบร้อย!`);
      return "success";
    }

  } catch (e) {
    console.error("❌ ข้อผิดพลาดในฟังก์ชันเซฟข้อมูล Batch Commit: " + e.message);
    throw new Error(e.message);
  }

  return "ไม่มีการดำเนินการใดๆ";
}

/**
 * 1. บันทึกข้อมูล หรือบันทึกซ้ำใบสั่งซื้อ (ฉบับร่าง)
