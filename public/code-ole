function getAuditLogsDev(searchUserId, searchDate) {
  try {
    Logger.log("==========================================");
    Logger.log("🔍 [SEARCH LOGS] เริ่มต้นค้นหา Audit Logs (แปลงเวลา GMT+7)");
    Logger.log(`👉 searchUserId: '${searchUserId}', searchDate: '${searchDate}'`);

    const payload = {
      structuredQuery: {
        from: [{ collectionId: "audit_logs" }],
        orderBy: [
          {
            field: { fieldPath: "__name__" },
            direction: "DESCENDING" // ดึงเอกสารใหม่ล่าสุดขึ้นก่อน
          }
        ],
        limit: 500
      }
    };

    if (searchUserId && searchUserId.trim() !== "") {
      payload.structuredQuery.where = {
        fieldFilter: {
          field: { fieldPath: "user_id" },
          op: "EQUAL",
          value: { stringValue: searchUserId.trim() }
        }
      };
    }

    const response = callFirestore("POST", ":runQuery", payload);

    if (!response || response.error) {
      Logger.log("❌ callFirestore เกิดข้อผิดพลาด: " + JSON.stringify(response ? response.error : "null"));
      return [];
    }

    let rawDocs = [];
    if (Array.isArray(response)) {
      rawDocs = response.map(item => item.document).filter(doc => doc && doc.fields);
    } else if (response.documents && Array.isArray(response.documents)) {
      rawDocs = response.documents;
    }

    Logger.log(`📦 ดึงเอกสารจาก Firestore สำเร็จทั้งหมด: ${rawDocs.length} รายการ`);

    let results = [];
    const cleanDate = searchDate ? searchDate.trim() : "";

    rawDocs.forEach((doc, idx) => {
      const fields = doc.fields || {};
      const userId = (fields.user_id && fields.user_id.stringValue) ? fields.user_id.stringValue : "";
      const userName = (fields.user_name && fields.user_name.stringValue) ? fields.user_name.stringValue : "";
      const timestamp = (fields.timestamp && fields.timestamp.stringValue) ? fields.timestamp.stringValue : "";
      const action = (fields.action && fields.action.stringValue) ? fields.action.stringValue : "";
      const details = (fields.details && fields.details.stringValue) ? fields.details.stringValue : "";

      // 🎯 แปลง ISO Timestamp (UTC) ให้เป็น วันที่เวลาไทย (GMT+7: YYYY-MM-DD)
      let docDateStr = "";
      if (timestamp) {
        try {
          docDateStr = Utilities.formatDate(new Date(timestamp), "GMT+7", "yyyy-MM-dd");
        } catch (e) {
          docDateStr = timestamp.substring(0, 10);
        }
      }

      let matchDate = cleanDate ? (docDateStr === cleanDate) : true;

      // 📌 พ่น Log รายการ 5 รายการแรก เพื่อตรวจดูการแปลงวันที่จริง
      if (idx < 5) {
        Logger.log(`📄 [#${idx + 1}] Raw: '${timestamp}' -> Local Date: '${docDateStr}' | Target Date: '${cleanDate}' | Match: ${matchDate}`);
      }

      if (matchDate) {
        results.push({
          timestamp: timestamp,
          action: action,
          details: details,
          user_name: userName,
          user_id: userId
        });
      }
    });

    Logger.log(`🎯 สรุปผลการค้นพบที่ตรงเงื่อนไข: ${results.length} รายการ`);
    Logger.log("==========================================");

    return results.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

  } catch (e) {
    Logger.log("❌ Exception ใน getAuditLogsDev: " + e.toString());
    return [];
  }
}

/**
 * 🔍 ฟังก์ชันตรวจสอบเปรียบเทียบยอด Cash Out (ยอดถอดบิล vs ยอดพนักงานคีย์) รายเดือน
 * @param {Object} filterObj - { month: "2026-06", shop: "All", statusFilter: "ALL", hideNoData: true }
 */
function checkCashoutAuditData(filterObj = {}) {
  console.log("--- [START] checkCashoutAuditData (Monthly Audit Mode) ---");
  const scriptProperties = PropertiesService.getScriptProperties();
  const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
  const projectId = keyFile.project_id;
  const dbPrefix = `projects/${projectId}/databases/(default)/documents`;

  // 🎯 1. กำหนดเดือนที่ต้องการตรวจสอบ (ฟอร์แมต YYYY-MM เช่น "2026-06")
  let targetMonth = filterObj.month;
  if (!targetMonth) {
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, '0');
    targetMonth = `${yyyy}-${mm}`;
  }

  // คำนวณวันทั้งหมดในเดือนที่เลือก
  const [yearStr, monthStr] = targetMonth.split('-');
  const year = parseInt(yearStr, 10);
  const month = parseInt(monthStr, 10);
  const daysInMonth = new Date(year, month, 0).getDate();

  const dateKeys = [];
  for (let d = 1; d <= daysInMonth; d++) {
    const dd = String(d).padStart(2, '0');
    dateKeys.push(`${targetMonth}-${dd}`);
  }

  // 🎯 2. ร้านค้าที่ต้องการดึงข้อมูล
  let shopsToFetch = [];
  const isAllShops = !filterObj.shop || filterObj.shop === "All" || filterObj.shop === "" || filterObj.shop === "-- ทุกร้าน --";
  if (isAllShops) {
    shopsToFetch = ['Atom', 'Atom_Beach', 'Good_Time', 'Tiger_King_Bar_&_Bistro', 'Paradise'];
  } else {
    const shopFormatted = typeof getUnifiedShopName === 'function' ? getUnifiedShopName(filterObj.shop) : filterObj.shop;
    shopsToFetch = [shopFormatted];
  }

  // 🎯 3. สร้าง Paths สำหรับ BatchGet (ยุบการส่ง Request ให้เหลือเท่าที่จำเป็น)
  const cashoutPaths = [];
  const incomePaths = [];

  shopsToFetch.forEach(shop => {
    const shopFormatted = typeof getUnifiedShopName === 'function' ? getUnifiedShopName(shop) : shop;
    dateKeys.forEach(dateKey => {
      cashoutPaths.push(`${dbPrefix}/cashout/${shopFormatted}/days/${dateKey}`);
      incomePaths.push(`${dbPrefix}/income/${shopFormatted}/daily_records/${dateKey}`);
    });
  });

  // 🎯 4. ดึงข้อมูลฝั่ง Cashout
  const cashoutDataMap = {};
  if (cashoutPaths.length > 0) {
    try {
      const batchResponse = callFirestore("POST", ":batchGet", { documents: cashoutPaths });
      if (Array.isArray(batchResponse)) {
        batchResponse.forEach(res => {
          if (res.found) {
            const fullPath = res.found.name;
            const fields = fromFirestoreFields(res.found.fields) || {};
            cashoutDataMap[fullPath] = {
              parentBillTotal: Number(fields.bill_total || fields.total_amount || 0),
              status: fields.status || "pending",
              url: fields.folder_url || fields.url || ""
            };
          }
        });
      }
    } catch (e) {
      console.warn("⚠️ Error BatchGet Cashout: " + e.message);
    }
  }

  // 🎯 5. ดึงข้อมูลฝั่ง Income (ยอดที่พนักงานคีย์)
  const incomeDataMap = {};
  if (incomePaths.length > 0) {
    try {
      const batchResponse = callFirestore("POST", ":batchGet", { documents: incomePaths });
      if (Array.isArray(batchResponse)) {
        batchResponse.forEach(res => {
          if (res.found) {
            const fullPath = res.found.name;
            const f = res.found.fields ? res.found.fields.cash_out : null;
            const val = f ? (f.doubleValue || f.integerValue || (f.stringValue ? parseFloat(f.stringValue) : 0)) : 0;
            incomeDataMap[fullPath] = Number(val) || 0;
          }
        });
      }
    } catch (e) {
      console.warn("⚠️ Error BatchGet Income: " + e.message);
    }
  }

  // 🎯 6. ดึงยอดบิลย่อย Subcollection (เฉพาะวันที่มีการอัปโหลด Cashout)
  const billTotalMap = {};
  shopsToFetch.forEach(shop => {
    const shopFormatted = typeof getUnifiedShopName === 'function' ? getUnifiedShopName(shop) : shop;
    dateKeys.forEach(dateKey => {
      const fullPathId = `${shopFormatted}/days/${dateKey}`;
      const cPath = `${dbPrefix}/cashout/${fullPathId}`;
      
      if (cashoutDataMap[cPath]) {
        let subBillTotal = 0;
        try {
          const billsResp = callFirestore("GET", `cashout/${fullPathId}/bills`);
          if (billsResp && billsResp.documents && Array.isArray(billsResp.documents)) {
            billsResp.documents.forEach(doc => {
              if (doc.fields) {
                const bFields = fromFirestoreFields(doc.fields) || {};
                subBillTotal += (Number(bFields.bill_total) || Number(bFields.total_amount) || 0);
              }
            });
          }
        } catch (e) {
          // หากไม่มี subcollection บิล
        }
        const parentTotal = cashoutDataMap[cPath].parentBillTotal || 0;
        billTotalMap[fullPathId] = subBillTotal > 0 ? subBillTotal : parentTotal;
      } else {
        billTotalMap[fullPathId] = 0;
      }
    });
  });

  // 🎯 7. ประมวลผลและจัดหมวดหมู่การตรวจสอบ (Audit Logic)
  const auditResults = [];
  let summary = { match: 0, mismatch: 0, pending: 0, noData: 0 };

  shopsToFetch.forEach(shop => {
    const shopFormatted = typeof getUnifiedShopName === 'function' ? getUnifiedShopName(shop) : shop;
    
    dateKeys.forEach(dateKey => {
      const fullPathId = `${shopFormatted}/days/${dateKey}`;
      const cPath = `${dbPrefix}/cashout/${fullPathId}`;
      const iPath = `${dbPrefix}/income/${shopFormatted}/daily_records/${dateKey}`;

      const billTotal = billTotalMap[fullPathId] || 0;
      const enteredCashOut = incomeDataMap[iPath] || 0;
      const diff = Math.abs(billTotal - enteredCashOut);

      let auditStatus = "MATCH";
      let statusText = "ตรงกัน";

      if (billTotal === 0 && enteredCashOut === 0) {
        auditStatus = "NO_DATA";
        statusText = "ไม่มีข้อมูล";
        summary.noData++;
      } else if (billTotal > 0 && enteredCashOut === 0) {
        auditStatus = "PENDING_INPUT";
        statusText = "ยังไม่คีย์ในระบบ";
        summary.pending++;
      } else if (diff > 0.01) {
        auditStatus = "MISMATCH";
        statusText = "ยอดไม่ตรงกัน";
        summary.mismatch++;
      } else {
        auditStatus = "MATCH";
        statusText = "ตรงกัน";
        summary.match++;
      }

      // ซ่อนรายการที่ไม่มีข้อมูลทั้งคู่ ถ้าผู้ใช้เปิดตัวเลือก hideNoData
      if (filterObj.hideNoData && auditStatus === "NO_DATA") {
        return;
      }

      // กรองตาม statusFilter ถ้าระบุ
      if (!filterObj.statusFilter || filterObj.statusFilter === "ALL" || filterObj.statusFilter === auditStatus) {
        auditResults.push({
          docId: fullPathId,
          shop: shopFormatted,
          dateKey: dateKey,
          billTotalAmount: billTotal,      // 🟢 ยอดรวมบิลที่สแกน
          cashOutAmount: enteredCashOut,   // 🔵 ยอดพนักงานคีย์
          diffAmount: diff,                // 🔴 ผลต่าง
          auditStatus: auditStatus,        // สถานะระบบ: MATCH, MISMATCH, PENDING_INPUT, NO_DATA
          statusText: statusText,
          url: cashoutDataMap[cPath] ? cashoutDataMap[cPath].url : ""
        });
      }
    });
  });

  return {
    month: targetMonth,
    summary: summary,
    items: auditResults
  };
}