function formatShopToIncomeStyle(name) {
  if (!name) return "Unknown";
  
  // 1. แปลงเป็นตัวเล็กและตัดช่องว่างหัวท้าย เพื่อใช้ตรวจสอบเคสพิเศษ
  const shopLower = name.toString().trim().toLowerCase();

  // 2. รายการเคสพิเศษ (Mapping)
  const specialCases = {
    'goodtime': 'Good_Time',
    'atombeach': 'Atom_Beach',
    'atom': 'Atom',
    'paradise': 'Paradise',
    'tigerking': 'Tiger_King_Bar_&_Bistro'
  };

  // 3. ตรวจสอบเงื่อนไขเคสพิเศษก่อน
  if (specialCases[shopLower]) {
    return specialCases[shopLower];
  }

  // 4. หากไม่ใช่เคสพิเศษ ให้ใช้ Logic มาตรฐาน (Title Case + Underscore)
  return name.toString().trim()
    .split(/\s+/) 
    .map(word => {
      if (word.length === 0) return "";
      return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
    })
    .join('_');
}

function getAllCashoutData(filterObj = {}) {
  console.log("--- [START] getAllCashoutData (Localized Daily Precision Mode) ---");
  const scriptProperties = PropertiesService.getScriptProperties();
  const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
  const projectId = keyFile.project_id;
  const dbPrefix = `projects/${projectId}/databases/(default)/documents`;

  const ROOT_COLLECTION = "cashout"; 

  // 🎯 1. แกะค่าวันที่ที่ส่งมาจากหน้าบ้าน (ฟอร์แมต YYYY-MM-DD เช่น "2026-06-17")
  let targetDateStr = filterObj.dateRaw; 
  if (!targetDateStr) {
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, '0');
    const dd = String(today.getDate()).padStart(2, '0');
    targetDateStr = `${yyyy}-${mm}-${dd}`;
  }

  // 🎯 2. รายชื่อ 5 ร้านค้าหลักตรงตามโครงสร้างระบบ
  let shopsToFetch = [];
  const isAllShops = !filterObj.shop || filterObj.shop === "All" || filterObj.shop === "" || filterObj.shop === "-- ทุกร้าน --";

  if (isAllShops) {
    shopsToFetch = ['Atom', 'Atom_Beach', 'Good_Time', 'Tiger_King_Bar_&_Bistro', 'Paradise'];
  } else {
    const shopFormatted = typeof getUnifiedShopName === 'function' ? getUnifiedShopName(filterObj.shop) : filterObj.shop;
    shopsToFetch = [shopFormatted];
  }

  const folderDataList = [];
  const incomeFullPaths = [];

  // 🎯 3. สร้างเส้นทางเพื่อดึงข้อมูลหลักผ่าน BatchGet
  const cashoutPathsToFetch = [];
  const pathToMetaMap = {};

  shopsToFetch.forEach(shop => {
    const oldPath = `${dbPrefix}/${ROOT_COLLECTION}/${shop}/days/${targetDateStr}`;
    cashoutPathsToFetch.push(oldPath);
    pathToMetaMap[oldPath] = { shopName: shop, dateKey: targetDateStr };
  });

  // ทำ Batch Get ดึงข้อมูลฝั่งสถานะ Cash Out
  if (cashoutPathsToFetch.length > 0) {
    const uniquePaths = [...new Set(cashoutPathsToFetch)];
    try {
      const batchResponse = callFirestore("POST", ":batchGet", { documents: uniquePaths });
      
      if (Array.isArray(batchResponse)) {
        batchResponse.forEach(res => {
          if (res.found) {
            const currentPath = res.found.name;
            const meta = pathToMetaMap[currentPath];
            if (meta) {
              const fields = fromFirestoreFields(res.found.fields) || {};
              
              folderDataList.push({
                shopName: meta.shopName,
                dateKey: meta.dateKey,
                url: fields.folder_url || fields.url || "",
                status: fields.status || "pending",
                parentBillTotal: Number(fields.bill_total || fields.total_amount || 0),
                fullPathId: `${meta.shopName}/days/${meta.dateKey}`
              });
            }
          }
        });
      }
    } catch (e) {
      console.warn("⚠️ เกิดข้อผิดพลาดในการดึงข้อมูลหลัก Cash Out ผ่าน BatchGet: " + e.message);
    }
  }

  // เติมร้านค้าสแตนด์บายกรณีไม่มีประวัติอัปโหลด
  shopsToFetch.forEach(shop => {
    const hasData = folderDataList.some(item => item.shopName === shop);
    if (!hasData) {
      folderDataList.push({
        shopName: shop,
        dateKey: targetDateStr,
        url: "",
        status: "pending",
        parentBillTotal: 0,
        fullPathId: `${shop}/days/${targetDateStr}`
      });
    }
  });

  // 🎯 4. ดึงยอดเงินสดออกจากฝั่ง income (income -> daily_records)
  folderDataList.forEach(item => {
    const shopFormatted = typeof getUnifiedShopName === 'function' ? getUnifiedShopName(item.shopName) : item.shopName;
    const targetPath = `${dbPrefix}/income/${shopFormatted}/daily_records/${item.dateKey}`;
    incomeFullPaths.push(targetPath);
  });

  const incomeMap = {};
  if (incomeFullPaths.length > 0) {
    const uniqueIncomePaths = [...new Set(incomeFullPaths)];
    try {
      const batchResponse = callFirestore("POST", ":batchGet", { documents: uniqueIncomePaths });
      if (Array.isArray(batchResponse)) {
        batchResponse.forEach(res => {
          if (res.found) {
            const fullPathName = res.found.name;
            const f = res.found.fields.cash_out;
            incomeMap[fullPathName] = f ? (f.doubleValue || f.integerValue || (f.stringValue ? parseFloat(f.stringValue) : 0)) : 0;
          }
        });
      }
    } catch (e) {
      console.warn("⚠️ เกิดข้อผิดพลาดในการดึงยอดเงินสดออกจากโครงสร้าง income: " + e.message);
    }
  }

  // 🎯 5. [เพิ่มใหม่]: ดึงบิลย่อยใน Subcollection "bills" ของแต่ละร้าน เพื่อรวมยอดจริงที่ถอดจากบิลสแกน (billTotalAmount)
  const billTotalMap = {};
  folderDataList.forEach(item => {
    const targetSubCollection = `cashout/${item.fullPathId}/bills`;
    let shopBillTotal = 0;
    
    try {
      const billsResponse = callFirestore("GET", targetSubCollection);
      if (billsResponse && billsResponse.documents && Array.isArray(billsResponse.documents)) {
        billsResponse.documents.forEach(doc => {
          if (doc.fields) {
            const bFields = fromFirestoreFields(doc.fields) || {};
            const bTotal = Number(bFields.bill_total) || Number(bFields.total_amount) || 0;
            shopBillTotal += bTotal;
          }
        });
      }
    } catch (e) {
      console.warn(`⚠️ ไม่สามารถดึงบิลย่อยของ ${item.fullPathId}: ` + e.message);
    }

    // ถ้ารวมจาก bills ได้มากกว่า 0 ให้ใช้ค่านั้น ถ้าไม่มีใช้ค่า parentBillTotal (ถ้ามี)
    billTotalMap[item.fullPathId] = shopBillTotal > 0 ? shopBillTotal : (item.parentBillTotal || 0);
  });

  // 🎯 6. แมปข้อมูลส่งกลับหน้าบ้าน (พร้อมทั้ง 2 ยอดเงิน)
  const result = folderDataList.map(item => {
    const shopFormatted = typeof getUnifiedShopName === 'function' ? getUnifiedShopName(item.shopName) : item.shopName;
    const targetPath = `${dbPrefix}/income/${shopFormatted}/daily_records/${item.dateKey}`;

    return {
      docId: item.fullPathId, 
      shop: item.shopName,
      dateShow: item.dateKey, // YYYY-MM-DD
      dateRaw: item.dateKey,
      url: item.url, 
      status: item.status, 
      billTotalAmount: billTotalMap[item.fullPathId] || 0, // 🟢 [เพิ่มใหม่]: ยอด cash out จากบิลจริง (สแกนถอดได้)
      cashOutAmount: incomeMap[targetPath] || 0            // 🔵 ยอด cash out ที่พนักงานคีย์ในระบบหลัก
    };
  });

  console.log(`📊 ดึงข้อมูลรายวันสำเร็จ [${targetDateStr}] ยอดรวมที่พร้อมแสดงผล: ${result.length} รายการ`);
  return result;
}

function getCashoutItems(datePath) {
