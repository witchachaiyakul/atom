}

function getAllIncomeData() {
  const scriptProperties = PropertiesService.getScriptProperties();
  const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
  const token = getAccessToken(keyFile);
  const projectId = keyFile.project_id;

  const targetStores = ["Atom", "Atom_Beach", "Good_Time", "Paradise", "Tiger_King_Bar_&_Bistro"];
  let allDocuments = [];

  try {
    targetStores.forEach(storeId => {
      const encodedStoreId = encodeURIComponent(storeId);
      let pageToken = "";

      // 🟢 เพิ่ม Loop pageToken เพื่อดึงข้อมูลเกิน 300 รายการจนครบทั้งหมด
      do {
        let url = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents/income/${encodedStoreId}/daily_records?pageSize=300`;
        if (pageToken) url += `&pageToken=${pageToken}`;
        
        const options = {
          method: "GET",
          headers: { Authorization: "Bearer " + token },
          muteHttpExceptions: true
        };

        const response = UrlFetchApp.fetch(url, options);
        if (response.getResponseCode() === 200) {
          const json = JSON.parse(response.getContentText());
          if (json.documents && Array.isArray(json.documents)) {
            allDocuments.push(...json.documents);
          }
          pageToken = json.nextPageToken; // ดึง Token หน้าถัดไป
        } else {
          pageToken = null;
        }
      } while (pageToken);
    });

    const getV = (field) => {
      if (!field) return 0;
      if (field.doubleValue !== undefined) return Number(field.doubleValue);
      if (field.integerValue !== undefined) return Number(field.integerValue);
      if (field.stringValue !== undefined) return parseFloat(field.stringValue) || 0;
      return 0;
    };

    return allDocuments.map((doc, index) => {
      const f = doc.fields || {};
      const docId = doc.name.split('/').pop(); 
      const pathSegments = doc.name.split('/');
      const storeInDb = decodeURIComponent(pathSegments[pathSegments.length - 3]); 
      const shopDisplay = storeInDb.replace(/_/g, ' '); 

      let ochaSummary = { Cash: 0, VISA: 0, Mastercard: 0, "Bank Transfer": 0, Other: 0, "Total Amount Collected": 0 };
      
      if (f.records && f.records.arrayValue && f.records.arrayValue.values && f.records.arrayValue.values.length > 0) {
        const firstRow = f.records.arrayValue.values[0];
        if (firstRow.mapValue && firstRow.mapValue.fields) {
          const rf = firstRow.mapValue.fields;
          ochaSummary.Cash = getV(rf.Cash);
          ochaSummary.VISA = getV(rf.VISA);
          ochaSummary.Mastercard = getV(rf.Mastercard);
          ochaSummary["Bank Transfer"] = getV(rf["Bank Transfer"]) || getV(rf.BankTransfer);
          ochaSummary.Other = getV(rf.Other);
          ochaSummary["Total Amount Collected"] = getV(rf["Total Amount Collected"]) || getV(rf.TotalAmountCollected);
        }
      } else {
        ochaSummary.Cash = getV(f.cash);
        ochaSummary.VISA = getV(f.visa);
        ochaSummary.Mastercard = getV(f.mastercard);
        ochaSummary["Bank Transfer"] = getV(f.bank_transfer);
        ochaSummary.Other = getV(f.other_ocha);
        ochaSummary["Total Amount Collected"] = getV(f.total_amount);
      }

      return {
        docId: docId, 
        row: index + 2,
        dateRaw: docId, 
        dateShow: docId,          
        shop: shopDisplay,
        cash: ochaSummary.Cash,
        visa: ochaSummary.VISA,
        mastercard: ochaSummary.Mastercard,      
        bank_transfer: ochaSummary["Bank Transfer"], 
        other_ocha: ochaSummary.Other,      
        total_amount: ochaSummary["Total Amount Collected"],  
        cash_out: getV(f.cash_out),
        tip: getV(f.tip),
        tip_type: (f.tip_type && f.tip_type.stringValue) ? f.tip_type.stringValue : "-",
        other_exp: getV(f.other_exp),
        net_cash: getV(f.net_cash),          
        status: (f.status && f.status.stringValue) ? f.status.stringValue : "",
        adj_visa: getV(f.adj_visa),
        adj_master: getV(f.adj_master),
        adj_transfer: getV(f.adj_transfer),
        adj_cash: getV(f.adj_cash),
        totalIncome: getV(f.net_cash),
        totalL: ochaSummary["Total Amount Collected"]
      };
    }).sort((a, b) => b.dateRaw.localeCompare(a.dateRaw));

  } catch (err) {
    Logger.log("❌ Dashboard Fetch Error: " + err.message);
    return [];
  }
}

// ฟังก์ชันสำหรับ "ขอเลข" มาโชว์ในหน้า Preview เฉยๆ (ยังไม่บันทึกอะไรลง Expense)
function getNextDocNo() {
  return generateDocNo(); // ส่งแค่เลข EXP-XXXXX กลับไป
}

function generateDocNo() {
  const now = new Date();
  const month = ("0" + (now.getMonth() + 1)).slice(-2);
  const yearShort = now.getFullYear().toString().slice(-2); 
  const currentPrefix = "EXP" + month + yearShort; // ผลลัพธ์: EXP0326

  // 1. ดึงข้อมูลจาก Collection 'explog' Document 'expense_doc_no'
  // หมายเหตุ: ปรับฟังก์ชัน callFirestore ให้รองรับการ GET document ตรงๆ
  const res = callFirestore("GET", "explog/expense_doc_no");
  
  let nextNum = 1;
  let lastPrefix = "";

  if (res && res.fields) {
    lastPrefix = res.fields.last_prefix.stringValue;
    const lastNumber = parseInt(res.fields.last_number.integerValue || res.fields.last_number.stringValue, 10);

    // 2. ตรวจสอบว่ายังเป็นเดือน/ปีเดิมไหม
    if (lastPrefix === currentPrefix) {
      // ถ้าเดือนปีเดิม ให้เอาเลขล่าสุด + 1
      nextNum = lastNumber + 1;
    } else {
      // ถ้าขึ้นเดือนใหม่ ให้เริ่มนับที่ 1 ใหม่
      nextNum = 1;
    }
  }

  // 3. เตรียมเลขที่เอกสารใหม่ (เช่น EXP03260001)
  const newDocNo = currentPrefix + nextNum.toString().padStart(4, '0');

  // 4. บันทึกค่าล่าสุดกลับลงไปใน explog ทันที เพื่อจองเลขไว้
  const updateData = {
    fields: {
      last_number: { integerValue: nextNum },
      last_prefix: { stringValue: currentPrefix }
    }
  };
  callFirestore("PATCH", "explog/expense_doc_no", updateData);

  return newDocNo;
}

function confirmAndSaveClaim(selectedItems, finalDocNo, userObj) { // 🎯 1. เพิ่มพารามิเตอร์ userObj มารับค่าโปรไฟล์จากหน้าบ้าน
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
    
    selectedItems.forEach((item, index) => {
      if (!item.docId) return;

      const updateData = {
        doc_no:   finalDocNo,
        clam_sub: "true",
        status:   "claimed"
      };

      const fieldsToUpdate = Object.keys(updateData);
      const updateMaskParams = fieldsToUpdate
        .map(field => `updateMask.fieldPaths=${field}`)
        .join('&');
        
      const path = `expense/${encodeURIComponent(item.docId)}?${updateMaskParams}`;
      
      // เพิ่ม Log เพื่อให้ตรวจสอบใน Executions ได้
      Logger.log(`กำลังบันทึกรายการที่ ${index + 1}: ${item.docId} ด้วยเลขเอกสาร ${finalDocNo}`);
      
      callFirestore("PATCH", path, toFirestoreFields(updateData));
    });

    // 🎯 2. เปลี่ยนส่งพารามิเตอร์ท้ายสุดจาก null เป็น userObj เพื่อลงล็อกชื่อพนักงานคนกดตั้งเบิกจริง
    insertAuditLog("CLAIM_SAVE", `ตั้งเบิกรายการจำนวน ${selectedItems.length} รายการ เลขเอกสาร: ${finalDocNo}`, userObj);

    return { status: "success" };
  } catch (e) {
    Logger.log("Error in confirmAndSaveClaim: " + e.toString());
    return { status: "error", message: e.toString() };
  } finally {
    lock.releaseLock();
  }
}

