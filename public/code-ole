}

/**
 * 2. ล็อกคิวตัวเลขเอกสารและจัดทำใบสั่งซื้อฉบับสมบูรณ์ (Issued) 
 * ป้องกันเลขรันชนกันโดยถอดแบบโครงสร้างการรันมาจาก /explog/expense_doc_no
 */
function finalizeAndIssuePO(poData) {
  const scriptProperties = PropertiesService.getScriptProperties();
  const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
  const projectId = keyFile.project_id;
  
  // จัดเตรียมรูปแบบ Prefix ตามเดือน/ปีปัจจุบัน เช่น กรกฎาคม 2026 -> "PO0726"
  const now = new Date();
  const yy = String(now.getFullYear()).substring(2);
  const mm = String(now.getMonth() + 1).padStart(2, '0');
  const currentPrefix = `PO${mm}${yy}`;
  
  // 1. เปิดระบบจองคิวข้อมูล (Begin Transaction)
  const beginRes = callFirestore("POST", ":beginTransaction", { options: { readWrite: {} } });
  if (!beginRes || !beginRes.transaction) {
    return { success: false, error: "ไม่สามารถเปิดสิทธิ์การจองเลขบิลในระบบได้" };
  }
  const transactionId = beginRes.transaction;

  try {
    // 2. ดึงข้อมูลเลขล่าสุดจากคอลเลกชัน polog เอกสาร po_doc_no ภายใต้ Transaction นี้
    const counterPath = `projects/${projectId}/databases/(default)/documents/polog/po_doc_no`;
    const batchGetRes = callFirestore("POST", ":batchGet", {
      documents: [counterPath],
      transaction: transactionId
    });

    let lastNumber = 0;
    let lastPrefix = "";

    // ถ้าเคยมีบันทึกตัวนับอยู่แล้ว ให้แกะฟิลด์ข้อมูลออกมาใช้งาน
    if (batchGetRes && batchGetRes[0] && batchGetRes[0].found) {
      const fields = batchGetRes[0].found.fields;
      if (fields) {
        if (fields.last_number) lastNumber = Number(fields.last_number.integerValue || fields.last_number.doubleValue || 0);
        if (fields.last_prefix) lastPrefix = fields.last_prefix.stringValue || "";
      }
    }

    // 3. เงื่อนไขตัดสินการรันเลขบิล: หากเปลี่ยนเดือนใหม่ให้เริ่มต้นนับ 1 ใหม่
    let nextNumber = 1;
    if (lastPrefix === currentPrefix) {
      nextNumber = lastNumber + 1;
    }

    // ฟอร์แมตออกเลขบิลทางการ เช่น PO0726-0077
    const finalPoNo = `${currentPrefix}-${String(nextNumber).padStart(4, '0')}`;
    
    // 4. ผูกตัวแปรเพิ่มเติมเข้าไปใน Object ก่อนส่งเข้าฐานข้อมูล
    poData.po_number = finalPoNo;
    poData.status = "issued";
    poData.issued_at = new Date().toISOString();
    
    const newDocPath = `projects/${projectId}/databases/(default)/documents/purchase_orders/${finalPoNo}`;
    
    // 5. เตรียมคำสั่งคอมมิตบันทึกแบบกลุ่ม (Atomic Write Commit)
    const commitPayload = {
      transaction: transactionId,
      writes: [
        {
          // สั่งอัปเดตตัวนับตัวล่าสุดในเดือนปัจจุบันกลับไปที่คอลเลกชัน polog
          update: {
            name: counterPath,
            fields: {
              last_number: { integerValue: nextNumber },
              last_prefix: { stringValue: currentPrefix }
            }
          }
        },
        {
          // สั่งสร้างเอกสารใบสั่งซื้อตัวจริงลงคอลเลกชันหลัก
          update: {
            name: newDocPath,
            fields: toFirestoreFields(poData).fields
          }
        }
      ]
    };

    // ตัวเสริมพิเศษ: หากบิลนี้เคยเซฟเป็นแบบร่าง (Draft) มาก่อน ให้สั่งลบใบฉบับร่างชั่วคราวทิ้งไปด้วยครับ
    if (poData.id && poData.id !== finalPoNo) {
      commitPayload.writes.push({
        delete: `projects/${projectId}/databases/(default)/documents/purchase_orders/${poData.id}`
      });
    }

    const commitRes = callFirestore("POST", ":commit", commitPayload);
    if (commitRes && !commitRes.error) {
      return { success: true, po_number: finalPoNo };
    } else {
      return { success: false, error: commitRes.error ? JSON.stringify(commitRes.error) : "Commit Failed" };
    }

  } catch (err) {
    Logger.log("Error in finalizeAndIssuePO: " + err.message);
    return { success: false, error: err.message };
  }
}

