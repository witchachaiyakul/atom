function isLineIdAllowed(lineUserId) {
  try {
    const userData = callFirestore("GET", "users/" + lineUserId);
    
    if (!userData || userData.error) {
      console.warn("⚠️ ตรวจพบบัฟเฟอร์เออเร่อหรือไม่มีไอดีพนักงานบนระบบคลาวด์");
      return null;
    }
    
    // แกะรหัสตรวจสอบโครงสร้างข้อมูลของ Firestore REST API ตรงสาย
    if (userData.fields && userData.fields.status) {
      const status = userData.fields.status.stringValue;
      
      // ถ้าพนักงานมีสถานะใช้งานอยู่ (active) ให้ทำการแกะ Role และสิทธิ์การเลือกส่งกลับไป
      if (status === "active") {
        // ดึงฟิลด์ role (ถ้าไม่มีในฐานข้อมูลจะตั้งค่าเริ่มต้นเป็น "staff")
        const role = (userData.fields.role && userData.fields.role.stringValue) || "staff";
        
        // ดึงฟิลด์ allowedOptions เช่น "Option_A,Option_B" (ถ้าไม่มีจะตั้งเป็นค่าว่าง)
        const allowedOptionsStr = (userData.fields.allowedOptions && userData.fields.allowedOptions.stringValue) || "";
        
        return {
          role: role,
          // ตัดแบ่งข้อความคั่นด้วยจุลภาค (,) แปลงเป็น Array เพื่อให้หน้าบ้านเอาไปใช้ลูปจัดการ UI ได้สะดวกครับ
          allowedOptions: allowedOptionsStr ? allowedOptionsStr.split(",").map(item => item.trim()) : []
        };
      }
    }
    
    return null;
  } catch (e) {
    console.error("❌ เกิดข้อผิดพลาดในขั้นตอนสแกนสิทธิ์สัญญาน: " + e.toString());
    return null;
  }
}

