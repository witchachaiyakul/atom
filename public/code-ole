    }
  };

  Logger.log(`--- เริ่มดึงข้อมูลค้างจ่าย (Claim Status Filter: ${status}) ---`);
  const response = callFirestore("POST", ":runQuery", queryPayload);

  if (response && response.error) {
    Logger.log("!!! Firestore Error: " + response.error.message);
    return [];
  }

  if (!response || !Array.isArray(response)) return [];

  const results = response.map((item) => {
    if (!item || !item.document || !item.document.fields) return null;
    
    const doc = item.document;
    try {
      const f = fromFirestoreFields(doc.fields);
      const docId = doc.name.split('/').pop();
      const docNo = (f.doc_no || "").trim(); 

      const dataObj = {
        docId: docId,
        ref: docNo,                    
        date: f.doc_date || "-",          
        supplier: f.supplier || "-",
        shop: f.shop || "-",
        list: f.list || "-",
        url: f.url || "",
        amount: parseFloat(f.total_amount || f.net_amount || 0)
      };
      
      if (status === 'claimed') {
        return (docNo !== "") ? dataObj : null;
      }
      if (status === 'not_claimed') {
        return (docNo === "") ? dataObj : null;
      }
      return dataObj;

    } catch (err) {
      return null;
    }
  }).filter(item => item !== null); 

  Logger.log(`สรุป: พบรายการที่ตรงเงื่อนไข (${status}) ทั้งหมด ${results.length} รายการ`);
  return results;
}

function savePaymentTransaction(payload, userObj) { // 🎯 1. เพิ่มพารามิเตอร์ userObj มารับค่าโปรไฟล์จากหน้าบ้าน
  const lock = LockService.getScriptLock();
  try {
    // 1. ล็อกคิวป้องกันระบบทำงานซ้อนกัน 30 วินาที
    lock.waitLock(30000);

    const { docIds, slip, receipt, namingInfo, pay_ch, pay_day } = payload;
    const { doc_no, supplier, total_amount } = namingInfo;
    
    if (!docIds || docIds.length === 0) throw new Error("ไม่พบรหัสเอกสาร (docIds)");

    // 2. ดึงสิทธิ์ความปลอดภัยคีย์ Firebase
    const scriptProperties = PropertiesService.getScriptProperties();
    const keyFileRaw = scriptProperties.getProperty('FIREBASE_KEY');
    if (!keyFileRaw) throw new Error("ไม่พบคีย์ FIREBASE_KEY ในระบบ Script Properties");
    
    const keyFile = JSON.parse(keyFileRaw);
    const token = getAccessToken(keyFile);
    const bucketName = "atom-group-phi-phi.firebasestorage.app";

    // 🎯 3. ดึงข้อมูลบิลใบแรกจาก Firestore เพื่อระบุชื่อร้านค้ามาตรฐาน (ใช้ฟังก์ชันกลาง)
    const firstDocRes = callFirestore("GET", `expense/${encodeURIComponent(docIds[0])}`);
    if (firstDocRes.error) throw new Error("ไม่สามารถดึงข้อมูลบิลเพื่อระบุชื่อร้านค้าได้: " + firstDocRes.error.message);
    const firstDocFields = fromFirestoreFields(firstDocRes.fields);
    const rawShop = firstDocFields.shop || "Unknown";
    
    // 🎯 ใช้ฟังก์ชันกลาง getUnifiedShopName แทนการประกาศฟังก์ชันซ้อน
    const shopFolder = getUnifiedShopName(rawShop);

    // 🎯 4. แตกโครงสร้าง วัน/เดือน/ปี จากวันที่โอนจ่าย (pay_day: YYYY-MM-DD)
    let year = "2026", month = "01", day = "01";
    if (pay_day && pay_day.includes("-")) {
      const dateParts = pay_day.split("-");
      year = dateParts[0] || "2026";
      month = (dateParts[1] || "01").padStart(2, '0');
      day = (dateParts[2] || "01").padStart(2, '0');
    }

    // ล้างตัวอักษรพิเศษออกจากชื่อไฟล์ป้องกันลิ้งค์พัง
    const cleanBaseName = `${doc_no}_${supplier}_${total_amount}`.replace(/[/\\?%*:|"<> ]/g, '_');

    let slipUrl = "-";
    let receiptUrl = "-";

    // 🚀 5. สั่งลุยอัปโหลดหลักฐาน Slip เข้ากลุ่มคลังเสมือน slip_library
    if (slip && slip.base64) {
      const ext = slip.name.split('.').pop();
      const firebasePath = `slip_library/${shopFolder}/${year}/${month}/${day}/SLIP_${cleanBaseName}.${ext}`;
      slipUrl = uploadPaymentFileToFirebaseStorage(slip, firebasePath, bucketName, token);
    }

    // 🚀 6. สั่งลุยอัปโหลดหลักฐานใบเสร็จ Receipt เข้ากลุ่มคลังเสมือน slip_library
    if (receipt && receipt.base64) {
      const ext = receipt.name.split('.').pop();
      const firebasePath = `slip_library/${shopFolder}/${year}/${month}/${day}/RECEIPT_${cleanBaseName}.${ext}`;
      receiptUrl = uploadPaymentFileToFirebaseStorage(receipt, firebasePath, bucketName, token);
    }

    // 7. เตรียมชุดข้อมูลสลักหลังปิดยอดบิลจ่ายเงินเรียบร้อย
    const updateData = {
      paid: "true",
      receipt: receiptUrl,
      slip: slipUrl,
      pay_ch: pay_ch,
      pay_day: pay_day,
      paid_at: new Date().toISOString()
    };

    // ทำโครงสร้าง Mask ป้องกันฟิลด์อื่นในเอกสารโดนลบกระจุย
    const updateMask = Object.keys(updateData)
      .map(key => `updateMask.fieldPaths=${key}`)
      .join('&');

    const firestorePayload = toFirestoreFields(updateData);

    // 8. วนลูปอัปเดตสถานะบิลค้างจ่ายทุกใบ
    docIds.forEach(id => {
      const pathWithMask = `expense/${encodeURIComponent(id)}?${updateMask}`;
      const res = callFirestore("PATCH", pathWithMask, firestorePayload);
      if (res && res.error) {
        Logger.log(`Error ID ${id}: ` + JSON.stringify(res.error));
      }
    });

    // 🎯 2. เปลี่ยนพารามิเตอร์ท้ายสุดจาก null เป็น userObj เพื่อลงล็อกชื่อคนกดจ่ายเงินสำเร็จ
    insertAuditLog("PAYMENT_SUCCESS", `จ่ายเงินบิลเลขที่: ${doc_no} ร้าน: ${shopFolder} จำนวน: ${docIds.length} ใบ`, userObj);

    return { success: true };

  } catch (e) {
    console.error("savePaymentTransaction Error: " + e.toString());
    // 🎯 3. เปลี่ยนพารามิเตอร์ท้ายสุดในบล็อก Error เป็น userObj เพื่อให้รู้ว่าใครกำลังทำงานอยู่ตอนที่ระบบหลุด
    insertAuditLog("PAYMENT_FAIL", `จ่ายเงินล้มเหลว: ${doc_no || 'Unknown'} สาเหตุ: ${e.message}`, userObj);
    throw new Error("บันทึกข้อมูลล้มเหลว: " + e.message);
  } finally {
    lock.releaseLock();
  }
}

function uploadPaymentFileToFirebaseStorage(fileObj, firebasePath, bucketName, token) {
  try {
    const bytes = Utilities.base64Decode(fileObj.base64);
    const fileName = firebasePath.split('/').pop();
    
    // 🎯 ห่อหุ้มเนื้อไฟล์ให้อยู่ในสถานะวัตถุ Blob บริสุทธิ์ก่อนยิงส่งคลาวด์
    const blob = Utilities.newBlob(bytes, fileObj.type, fileName);

    // ขั้นยิงเนื้อไฟล์ดิบเข้าถังเก็บ
    const uploadUrl = `https://firebasestorage.googleapis.com/v0/b/${bucketName}/o?uploadType=media&name=${encodeURIComponent(firebasePath)}`;
    const uploadOptions = {
      method: "post",
      contentType: fileObj.type,
      payload: blob, 
      headers: { Authorization: "Bearer " + token },
      muteHttpExceptions: true
    };
    
    const uploadResponse = UrlFetchApp.fetch(uploadUrl, uploadOptions);
    if (uploadResponse.getResponseCode() !== 200) {
      throw new Error("Firebase Storage Upload Failed: " + uploadResponse.getContentText());
    }

    // 🎯 [แก้ไขวิกฤตบั๊กสิทธิ์รูปพัง]: 
    // ยุบขบวนการ PATCH เมทาดาตารอบสองทิ้งไปเพื่อเลี่ยง Error 400 
    // ขยับมาแกะเอาค่า downloadTokens ของจริงที่ระบบ Firebase เจนเนอเรตมาให้โดยอัตโนมัติในขบวนการ Response แรกทันที
    const responseData = JSON.parse(uploadResponse.getContentText());
    const downloadToken = responseData.downloadTokens;

    if (!downloadToken) {
      throw new Error("ระบบ Cloud ไม่ได้ส่งสิทธิ์ Download Token กลับมา");
    }

    // พ่นลิงก์ URL พรีวิวสาธารณะตัวสมบูรณ์แบบใช้ Token แท้ ส่งกลับไปบันทึกลงฐานข้อมูลอย่างปลอดภัย
    return `https://firebasestorage.googleapis.com/v0/b/${bucketName}/o/${encodeURIComponent(firebasePath)}?alt=media&token=${downloadToken}`;

  } catch (e) {
    Logger.log("เกิดปัญหาระหว่างอัปโหลดไฟล์สลิป: " + e.toString());
    throw e;
  }
}

function getNormalizedShopName(rawShopName) {
  if (!rawShopName) return 'Unknown';
  
  const cleanKey = rawShopName.toString().trim().toLowerCase();
  
  const shopMapping = {
    'atom': 'Atom',
    'atom_beach': 'Atom_Beach',
    'atom_beach ': 'Atom_Beach',
    'atom_history': 'Atom_Beach', // ตัวอย่างเผื่อกรณีแอดมินพิมพ์ฟอร์แมตอื่น
    'good_time': 'Good_Time',
    'good_time ': 'Good_Time',
    'tigerking': 'Tiger_King_Bar_&_Bistro',
    'tiger_king_bar_&_bistro': 'Tiger_King_Bar_&_Bistro',
    'paradise': 'Paradise'
  };

  return shopMapping[cleanKey] || rawShopName; 
}

function toFirestoreFields(obj) {
  const fields = {};
  for (const key in obj) {
    fields[key] = toFirestoreValue(obj[key]);
  }
  return { fields: fields };
}

function toFirestoreValue(val) {
  if (val === null || val === undefined) {
    return { nullValue: null };
  }
  if (Array.isArray(val)) {
    return { arrayValue: { values: val.map(toFirestoreValue) } };
  }
  if (typeof val === 'object' && !(val instanceof Date)) {
    const mapFields = {};
    for (const k in val) {
      mapFields[k] = toFirestoreValue(val[k]);
    }
    return { mapValue: { fields: mapFields } };
  }
  if (typeof val === 'number') {
    return { doubleValue: val };
  }
  if (typeof val === 'boolean') {
    return { booleanValue: val };
  }
  return { stringValue: String(val) };
}

function sendBatchCommit(writes) {
