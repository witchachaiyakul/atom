function getDropdownData() {
  try {
    // 1. ดึงประเภทค่าใช้จ่ายจาก Collection "list" (ตามรูป image_224600.png)
    const resList = callFirestore("GET", "list");
    const items = resList.documents 
      ? resList.documents.map(doc => {
          const path = doc.name.split('/');
          return path[path.length - 1]; // ดึงชื่อ Document ID เช่น ค่า mixer, ค่าขนส่ง
        }) 
      : [];

    // 2. ดึงข้อมูลร้านค้าจาก Collection "shop" (ตามรูป image_2298b7.png)
    const resShops = callFirestore("GET", "shop");
    const shops = resShops.documents 
      ? resShops.documents.map(doc => {
          const path = doc.name.split('/');
          return path[path.length - 1]; // เช่น Atom, Good_Time
        }) 
      : [];

    // 3. ดึงข้อมูลผู้ขายจาก Collection "supplier" (ตามรูป image_229897.png)
    const resSuppliers = callFirestore("GET", "supplier?pageSize=300");
    const suppliers = resSuppliers.documents 
      ? resSuppliers.documents.map(doc => {
          const path = doc.name.split('/');
          return path[path.length - 1]; // เช่น Advice, Bird Seafood
        }) 
      : [];

    return {
      items: items.sort(),
      shops: shops.sort(),
      suppliers: suppliers.sort()
    };
  } catch (e) {
    console.error("Error in getDropdownData: " + e.toString());
    return { items: [], suppliers: [], shops: [] };
  }
}

function addNewOption(type, value, userObj) { // 🎯 1. เพิ่มพารามิเตอร์ userObj มารับค่าโปรไฟล์จากหน้าบ้าน
  try {
    let docId = value.trim();
    if (!docId) return getDropdownData();

    if (type === 'item') {
      // เพิ่มลงใน Collection "list"
      const payload = {
        fields: {
          name: { stringValue: docId }
        }
      };
      callFirestore("PATCH", `list/${encodeURIComponent(docId)}`, payload);

    } else if (type === 'shop') {
      // 🎯 2. ซิงค์ชื่อร้านค้าใหม่ให้เข้าสู่ระบบมาตรฐานขีดล่างสากลของพี่วิชชาก่อนบันทึก
      docId = getUnifiedShopName(docId);
      
      // เพิ่มลงใน Collection "shop"
      const payload = {
        fields: {
          name: { stringValue: docId },
          address: { stringValue: "-" },
          tax_id: { stringValue: "-" },
          logo: { stringValue: "" }
        }
      };
      callFirestore("PATCH", `shop/${encodeURIComponent(docId)}`, payload);

    } else if (type === 'supplier') {
      // เพิ่มลงใน Collection "supplier"
      const payload = {
        fields: {
          supplier: { stringValue: docId },
          name: { stringValue: docId },
          address: { stringValue: "-" },
          bank_id: { stringValue: "-" },
          tax_id: { stringValue: "-" },
          note: { stringValue: "done" }
        }
      };
      callFirestore("PATCH", `supplier/${encodeURIComponent(docId)}`, payload);
    }
    
    // 🎯 3. ส่งก้อนข้อมูลผู้ใช้งาน (userObj) จากหน้าบ้านเข้าไปแทนที่ค่า null เดิม เพื่อระบุตัวตนคนกดจริง
    insertAuditLog("NEW_OPTION", `เพิ่ม ${type} ใหม่ชื่อ: ${docId}`, userObj);

    // หลังจากบันทึกเสร็จ ให้ดึงข้อมูลใหม่ทั้งหมดส่งกลับไปที่หน้าเว็บ
    return getDropdownData();

  } catch (e) {
    console.error("Error in addNewOption: " + e.toString());
    throw new Error("ไม่สามารถเพิ่มข้อมูลใหม่ได้: " + e.message);
  }
}

function uploadSingleFile(base64Data, mimeType, firebasePath) {
