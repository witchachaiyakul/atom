    if (!keyFileRaw) {
      throw new Error("ไม่พบคีย์ FIREBASE_KEY ในระบบ Script Properties");
    }

    const keyFile = JSON.parse(keyFileRaw);
    const projectId = keyFile.project_id; // คงไว้ตามโครงสร้างเดิมของพี่วิชชา
    const token = getAccessToken(keyFile); 
    
    const bucketName = "atom-group-phi-phi.firebasestorage.app";

    const bytes = Utilities.base64Decode(base64Data);
    console.log("Decode Base64 สำเร็จ เตรียมยิงไฟล์ขนาด: " + bytes.length + " bytes");

    // ดึงชื่อไฟล์จากปลายทางเพื่อนำมาสร้างเป็นก้อน Blob ที่สมบูรณ์ ป้องกันไฟล์พัง
    const fileName = firebasePath.split('/').pop();
    const blob = Utilities.newBlob(bytes, mimeType, fileName);

    // 4. สั่งยิงอัปโหลดเนื้อไฟล์ Blob ขึ้นคลาวด์ Firebase Storage ผ่าน REST API
    const uploadUrl = "https://firebasestorage.googleapis.com/v0/b/" + bucketName + "/o?uploadType=media&name=" + encodeURIComponent(firebasePath);
    const uploadOptions = {
      method: "POST", // ปรับเป็นตัวพิมพ์ใหญ่ตามมาตรฐานสากล
      contentType: mimeType,
      payload: blob, 
      headers: { Authorization: "Bearer " + token },
      muteHttpExceptions: true
    };
    
    const uploadResponse = UrlFetchApp.fetch(uploadUrl, uploadOptions);
    const uploadCode = uploadResponse.getResponseCode();
    
    if (uploadCode !== 200) {
      throw new Error("Firebase Storage Upload API ตอบกลับล้มเหลว: " + uploadResponse.getContentText());
    }
    console.log("✅ สตรีมเนื้อไฟล์ขึ้นคลาวด์ Firebase สำเร็จ");

    // 🎯 [จุดแก้ไขวิกฤต]: แกะเอาค่า downloadTokens แท้ ๆ ที่ Firebase ส่งกลับคืนมาให้ใช้งาน
    const responseData = JSON.parse(uploadResponse.getContentText());
    const liveDownloadToken = responseData.downloadTokens;

    if (!liveDownloadToken) {
      throw new Error("ระบบคลาวด์ไม่ได้ส่งรหัสสิทธิ์ (Download Token) กลับคืนมา");
    }

    // 6. ประกอบร่างฟอร์แมตลิงก์พรีวิวสาธารณะโดยใช้ Token แท้ ส่งกลับไปเซฟลง Firestore
    const firebaseDownloadUrl = "https://firebasestorage.googleapis.com/v0/b/" + bucketName + "/o/" + encodeURIComponent(firebasePath) + "?alt=media&token=" + liveDownloadToken;
    console.log("--- [FINISH] ได้รับลิงก์คลังรูปภาพตัวใหม่พร้อมใช้งาน: " + firebaseDownloadUrl);

    return firebaseDownloadUrl;

  } catch (e) {
    console.error("เกิดข้อผิดพลาดรุนแรงที่ uploadSingleFile: " + e.toString());
    throw new Error("Firebase Storage Upload Error: " + e.message);
  }
}

function saveInvoiceBulk(allData, userObj) { // 🎯 1. เพิ่มพารามิเตอร์ userObj มารับค่าจากหน้าเว็บหน้าบ้าน
  console.log("--- [START] เริ่มต้นฟังก์ชัน saveInvoiceBulk ---");
  const lock = LockService.getScriptLock();
  
  try {
    console.log("กำลังรอ Lock (30 วินาที)...");
    lock.waitLock(30000); 
    console.log("ได้รับ Lock แล้ว");

    if (!allData || allData.length === 0) {
      console.error("Error: ไม่มีข้อมูลส่งมาจากหน้าเว็บ");
      return "error: ไม่มีข้อมูลส่งมา";
    }

    const scriptProperties = PropertiesService.getScriptProperties();
    const keyFileRaw = scriptProperties.getProperty('FIREBASE_KEY');
    if (!keyFileRaw) throw new Error("ไม่พบ FIREBASE_KEY ในระบบ");

    const keyFile = JSON.parse(keyFileRaw);
    const projectId = keyFile.project_id; 
    const writes = []; 

    const cleanNum = (val) => {
      if (!val) return 0;
      let n = typeof val === 'string' ? parseFloat(val.replace(/,/g, '')) : val;
      return isNaN(n) ? 0 : n;
    };

    const safeId = (txt) => String(txt).replace(/\s+/g, '_').replace(/\//g, '-');

    allData.forEach((data, index) => {
      const rawDate = data.doc_date || data.docDate || ""; 
      
      // 🎯 แปลงชื่อร้านให้ผ่านเกณฑ์มาตรฐานกลางก่อนประกอบโครงสร้าง ID
      const shopName = getUnifiedShopName(data.shop);
      const supplierName = (data.supplier || "Unknown").trim();
      const netAmount = cleanNum(data.net_amount || data.netAmount);
      const invoiceNo = (data.doc_no || data.docNo || "").trim(); 

      let formattedDate = "0000-00-00";
      if (rawDate) {
        const d = new Date(rawDate);
        if (!isNaN(d.getTime())) formattedDate = d.toISOString().split('T')[0]; 
      }

      const firestorePayload = {
        doc_no:       "", 
        invoice_no:   invoiceNo,
        doc_date:     formattedDate, 
        list:         data.list || data.itemType || "", 
        supplier:     data.supplier || "Unknown",
        shop:         shopName, // บันทึกชื่อร้านแบบมีขีดล่างมาตรฐานลงฟิลด์ข้อมูล
        net_amount:   netAmount,
        total_amount: netAmount,
        non_vat:      cleanNum(data.non_vat || data.exemptAmount),
        ex_vat:       cleanNum(data.ex_vat || data.basePrice),
        vat:          cleanNum(data.vat || data.vatValue),
        url:          data.url || "",
        status:       "done",
        clam_sub:     "false",
        paid:         "false",
        timestamp:    new Date().toISOString()
      };

      const docId = `${formattedDate}_${safeId(shopName)}_${safeId(supplierName)}_${netAmount.toFixed(2)}`;
      const fieldNames = Object.keys(firestorePayload);

      writes.push({
        update: {
          name: `projects/${projectId}/databases/(default)/documents/expense/${docId}`,
          fields: toFirestoreFields(firestorePayload).fields
        },
        updateMask: { fieldPaths: fieldNames }
      });
    });

    if (writes.length > 0) {
      const response = commitBatchToFirestore(writes, projectId);
      if (response.getResponseCode() !== 200) throw new Error("Firebase Error: " + response.getContentText());
    }

    const totalAmt = allData.reduce((sum, item) => sum + cleanNum(item.net_amount), 0);
    const shopName = allData.length > 0 ? getUnifiedShopName(allData[0].shop) : "Unknown";
    
    // 🎯 2. เปลี่ยนส่งพารามิเตอร์ท้ายสุดจาก null เป็น userObj เพื่อลงล็อกชื่อพนักงานคนกดจริง
    insertAuditLog("BULK_SAVE", `บันทึกบิลชุดใหม่ (${allData.length} รายการ) ร้าน ${shopName} ยอดรวม ${totalAmt.toFixed(2)} บาท`, userObj);

    return "success";
  } catch (e) {
    return "error: " + (e.message || e.toString());
  } finally {
    lock.releaseLock();
  }
}

/** * ฟังก์ชันส่ง Batch บันทึก */
function commitBatchToFirestore(writes, projectId) {
  const url = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents:commit`;
  
  const scriptProperties = PropertiesService.getScriptProperties();
  const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
  const token = getAccessToken(keyFile);

  const options = {
    method: "post",
    contentType: "application/json",
    payload: JSON.stringify({ writes: writes }),
    headers: { Authorization: "Bearer " + token },
    muteHttpExceptions: true 
  };
  return UrlFetchApp.fetch(url, options);
}

function getPendingClaims() {
  const queryPayload = {
    "structuredQuery": {
      "from": [{ "collectionId": "expense" }],
      "where": {
        "fieldFilter": {
          "field": { "fieldPath": "doc_no" },
          "op": "EQUAL",
          "value": { "stringValue": "" }
        }
      },
      "orderBy": [
        {
          "field": { "fieldPath": "doc_date" },
          "direction": "DESCENDING"
        }
      ]
    }
  };

  Logger.log("--- เริ่มการดึงข้อมูล Pending Claims ---");
  Logger.log("Payload ที่ส่งไป: " + JSON.stringify(queryPayload));

  const url = ":runQuery"; 
  const response = callFirestore("POST", url, queryPayload);

  Logger.log("Response จาก Firestore: " + JSON.stringify(response));

  if (response && response.error) {
    Logger.log("!!! พบข้อผิดพลาดจาก Firestore: " + response.error.message);
    return [];
  }

  if (!response || !Array.isArray(response) || response.length === 0) {
    Logger.log("ไม่พบรายการที่ตรงตามเงื่อนไข (Empty Result)");
    return [];
  }

  const results = response.map((item, index) => {
    const doc = item.document;
    if (!doc) return null;
    
    try {
      const f = fromFirestoreFields(doc.fields);
      const docId = doc.name.split('/').pop();
      
      return {
        docId: docId,
        supplier: f.supplier || "ไม่ระบุ",
        amount:   parseFloat(f.net_amount) || 0,
        date:     f.doc_date ? f.doc_date.split('-').reverse().join('/') : "-",
        
        invoice_no: f.invoice_no || "-",
        doc_date:   f.doc_date || "-",
        list:       f.list || "-",
        shop:       f.shop || "-",
        net_amount: parseFloat(f.net_amount) || 0,
        
        doc_no:     f.doc_no || "", 
        vat:        parseFloat(f.vat) || 0,
        url:        f.url || "",
        non_vat:    parseFloat(f.non_vat) || 0,
        
        // 🎯 1. ดึงฟิลด์ clam_sub มารองรับการกรองข้อมูล
        clam_sub:   f.clam_sub || "" 
      };
    } catch (err) {
      Logger.log(`Error ในการ Map รายการที่ ${index}: ` + err.message);
      return null;
    }
  }).filter(item => {
    // 🎯 2. ตัวกรองขั้นเด็ดขาด (Post-Filter Step)
    if (item === null) return false;

    // ❌ ถ้า clam_sub เป็น "true" (String) หรือ true (Boolean) แปลว่าตั้งเบิกแล้ว ให้กรองทิ้งทันที!
    if (item.clam_sub === "true" || item.clam_sub === true) {
      return false;
    }

    return true; // ยอมให้เฉพาะบิลที่ยังไม่เคยตั้งเบิกผ่านหน้าจอไปแสดงผล
  });

  Logger.log(`สรุป: คัดกรองและดึงข้อมูลสำเร็จคงเหลือ ${results.length} รายการ`);
  return results;
}

function getSummaryReport(start, end, store) {
  const scriptProperties = PropertiesService.getScriptProperties();
  const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
  const token = getAccessToken(keyFile);
  const projectId = keyFile.project_id;

  // คลังแมปชื่อร้านจากหน้าบ้านให้ตรงกับ ID โฟลเดอร์ที่จัดเก็บจริงบน Firestore
  const storeMap = {
    "Atom": "Atom",
    "Atom Beach": "Atom_Beach",
    "Good Time": "Good_Time",
    "Paradise": "Paradise",
    "Tiger King Bar & Bistro": "Tiger_King_Bar_&_Bistro"
  };

  // 🎯 [ข้อดีความเร็ว]: หากเลือกเจาะจงร้าน ระบบจะดึงข้อมูลเฉพาะร้านนั้น ๆ ทันที ช่วยลดอัตราการโอนข้อมูล (Save Quota แบนด์วิดท์)
  let targetStores = [];
  if (store === "ทั้งหมด") {
    targetStores = Object.values(storeMap);
  } else {
    const mappedStore = storeMap[store.trim()];
    targetStores = mappedStore ? [mappedStore] : [store.trim().replace(/\s+/g, '_')];
  }

  let allDocuments = [];

  try {
    // วนลูปยิงเก็บเอกสารตามรายชื่อร้านค้าเป้าหมายตรงช่องพิกัดย่อย
    targetStores.forEach(storeId => {
      const url = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents/income/${storeId}/daily_records?pageSize=300`;
      
      const options = {
        method: "GET",
        headers: { Authorization: "Bearer " + token },
        muteHttpExceptions: true
      };

      const response = UrlFetchApp.fetch(url, options);
      if (response.getResponseCode() === 200) {
        const json = JSON.parse(response.getContentText());
        if (json.documents && Array.isArray(json.documents)) {
          json.documents.forEach(doc => { allDocuments.push(doc); });
        }
      }
    });

    const getV = (field) => {
      if (!field) return 0;
      if (field.doubleValue !== undefined) return field.doubleValue;
      if (field.integerValue !== undefined) return parseInt(field.integerValue);
      if (field.stringValue !== undefined) return field.stringValue;
      return 0;
    };

    // นำก้อนข้อมูลทั้งหมดมาจัดระเบียบโครงสร้าง Hybrid และกรองช่วงเวลาในระดับหน้าบ้าน
    return allDocuments
      .map(doc => {
        const docId = doc.name.split('/').pop(); // ดึงวันที่ (YYYY-MM-DD) จากปลายทางชื่อเอกสาร
        const storeInDb = doc.name.split('/')[doc.name.split('/').length - 3]; // ดึงชื่อร้านค้าจากลำดับโฟลเดอร์ชั้นนอก
        const shopDisplay = storeInDb.replace(/_/g, ' '); 
        const f = doc.fields || {};

        // 🎯 ถอดรหัสโครงสร้างพัสดุข้อมูลตามแบบฉบับ Dashboard ของพี่วิชชาเด่น ๆ 100%
        let ochaSummary = { Cash: 0, VISA: 0, Mastercard: 0, "Bank Transfer": 0, Other: 0, "Total Amount Collected": 0 };
        
        if (f.records && f.records.arrayValue && f.records.arrayValue.values && f.records.arrayValue.values.length > 0) {
          // 🆕 ยุคบันทึกฟอร์แมตใหม่: ดึงจากโครงสร้าง records array ด้านใน
          const firstRow = f.records.arrayValue.values[0];
          if (firstRow.mapValue && firstRow.mapValue.fields) {
            const rf = firstRow.mapValue.fields;
            ochaSummary.Cash = getV(rf.Cash);
            ochaSummary.VISA = getV(rf.VISA);
            ochaSummary.Mastercard = getV(rf.Mastercard);
            ochaSummary["Bank Transfer"] = getV(rf["Bank Transfer"]) || getV(rf.BankTransfer);
            ochaSummary.Other = getV(rf.Other);
            ochaSummary["Total Amount Collected"] = getV(rf["Total Amount Collected"]) || getV(rf.TotalAmountCollected);
          }
        } else {
          // ⏪ ยุคบันทึกฟอร์แมตเก่า: ดึงจากฟิลด์ดั้งเดิมระดับนอกสุดของเอกสาร
          ochaSummary.Cash = getV(f.cash);
          ochaSummary.VISA = getV(f.visa);
          ochaSummary.Mastercard = getV(f.mastercard);
          ochaSummary["Bank Transfer"] = getV(f.bank_transfer);
          ochaSummary.Other = getV(f.other_ocha);
          ochaSummary["Total Amount Collected"] = getV(f.total_amount);
        }

        // จับคู่คีย์ข้อมูล (Mapping) สตรีมกลับไปให้ฟังก์ชันหน้าบ้าน renderSummaryTable() เรียกใช้งานตรง ๆ
        return {
          date: docId, 
          store: shopDisplay,
          cash: ochaSummary.Cash,
          visa: ochaSummary.VISA,
          master: ochaSummary.Mastercard,
          transfer: ochaSummary["Bank Transfer"],
          other: ochaSummary.Other,
          total: ochaSummary["Total Amount Collected"]
        };
      })
      .filter(item => {
        // กรองช่วงวันที่ (HTML Input คืนค่าเป็น YYYY-MM-DD ชนกับค่า docId ได้อย่างแม่นยำร้อยเปอร์เซ็นต์)
        return item.date >= start && item.date <= end;
      })
      // 📈 เรียงลำดับจากวันที่เก่าไปใหม่ เพื่อไม่ให้กราฟเส้นของ Chart.js วาดข้อมูลสลับฝั่งสะดุดตา
      .sort((a, b) => a.date.localeCompare(b.date));

  } catch (err) {
    console.error("❌ getSummaryReport Error: " + err.message);
    return [];
  }
}

function formatDateToFirestore(dateStr) {
  if (!dateStr || !dateStr.includes("-")) return dateStr;
  const [y, m, d] = dateStr.split("-");
  return `${d}-${m}-${y}`;
}

function formatDateKey(date) {
  // 1. ถ้าค่าที่ส่งมาเป็นค่าว่าง ให้ส่ง String ว่างกลับไปเลย ไม่ต้อง toString() ให้ Error
  if (!date) return ""; 

  if (date instanceof Date) {
    // 2. ตรวจสอบว่า Date นั้นถูกต้องหรือไม่ (กันกรณี Invalid Date)
    if (isNaN(date.getTime())) return "";
    return Utilities.formatDate(date, "GMT+7", "yyyy-MM-dd");
  }
  
  // 3. ถ้าเป็น String อยู่แล้ว ให้ตัดช่องว่าง (Trim) ออกด้วย เพื่อการเทียบที่แม่นยำ
  return date.toString().trim();
}

function updateIncomeRecord(payload, userObj) { // 🎯 1. เพิ่มพารามิเตอร์ userObj มารับค่าโปรไฟล์จากหน้าบ้าน
  try {
    const scriptProperties = PropertiesService.getScriptProperties();
    const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
    const token = getAccessToken(keyFile);
    const projectId = keyFile.project_id;

    // คลีนชื่อ ID ให้เข้าสู่ระบบขีดล่างมาตรฐานสากล
    const dateId = payload.date.toString().trim().replace(/\//g, "-");
    const storeId = payload.store.toString().trim().replace(/\s+/g, '_');

    if (!storeId || !dateId) throw new Error("Missing Store ID or Date ID");

    // โครงสร้างฟิลด์แถวขาว/เหลืองคงเดิมตามที่หน้าบ้านพี่วิชชาส่งมา
    const fields = {
      "cash_out": { "doubleValue": Number(payload.cash_out) || 0 },
      "tip": { "doubleValue": Number(payload.tip) || 0 },
      "tip_type": { "stringValue": payload.tip_type || "-" },
      "other_exp": { "doubleValue": Number(payload.other_exp) || 0 },
      "net_cash": { "doubleValue": Number(payload.net_cash) || 0 },
      "adj_visa": { "doubleValue": Number(payload.adj_visa) || 0 },
      "adj_master": { "doubleValue": Number(payload.adj_master) || 0 },
      "adj_transfer": { "doubleValue": Number(payload.adj_transfer) || 0 },
      "adj_cash": { "doubleValue": Number(payload.adj_cash) || 0 },
      "status": { "stringValue": "done" }
    };

    // คงการใช้หน้ากากล็อกฟิลด์เพื่ออัปเดตเฉพาะค่าแก้ไข ยอด Ocha จากคลาวด์จะไม่หาย
    const masks = [
      "cash_out", "tip", "tip_type", "other_exp", "net_cash", 
      "adj_visa", "adj_master", "adj_transfer", "adj_cash", "status"
    ];
    const updateMask = masks.map(m => `updateMask.fieldPaths=${m}`).join('&');

    const firestoreUrl = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents/income/${storeId}/daily_records/${dateId}?${updateMask}`;
    
    const response = UrlFetchApp.fetch(firestoreUrl, {
      method: "PATCH",
      contentType: "application/json",
      headers: { Authorization: "Bearer " + token },
      payload: JSON.stringify({ fields: fields }),
      muteHttpExceptions: true
    });

    const resCode = response.getResponseCode();
    if (resCode == 200) {
      // 🎯 2. เปลี่ยนส่งพารามิเตอร์ท้ายสุดจาก null เป็น userObj เพื่อลงล็อกชื่อพนักงานคนกดแก้ไขจริง
      insertAuditLog("UPDATE_INCOME", `แก้ไขสรุปรายวัน: ${storeId}_${dateId} (ร้าน: ${payload.store})`, userObj);
      return "success";
    } else {
      console.error("Firestore Error: " + response.getContentText());
      return "Error: " + resCode;
    }

  } catch (e) {
    return "error: " + e.toString();
  }
}

