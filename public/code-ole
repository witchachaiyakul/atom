function callFirestore(method, path, payload = null) {
  const scriptProperties = PropertiesService.getScriptProperties();
  const keyFile = JSON.parse(scriptProperties.getProperty('FIREBASE_KEY'));
  const token = getAccessToken(keyFile);
  const projectId = keyFile.project_id;
  
  let baseUrl = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents`;
  
  // --- ส่วนที่ปรับปรุง: การต่อ URL ให้รองรับทั้ง : (commit), / (path) และ ? (query) ---
  let finalUrl = baseUrl;
  if (path) {
    if (path.startsWith(':') || path.startsWith('?')) {
      finalUrl += path; // ถ้าเป็น :commit หรือ ?pageSize ให้ต่อท้ายได้เลย
    } else {
      finalUrl += '/' + path; // ถ้าเป็นชื่อ collection ให้เติม / คั่นตามปกติ
    }
  }
  // -----------------------------------------------------------------------

  const options = {
    method: method,
    headers: { 
      Authorization: "Bearer " + token,
      "Content-Type": "application/json"
    },
    muteHttpExceptions: true
  };

  if (payload) options.payload = JSON.stringify(payload);

  const response = UrlFetchApp.fetch(finalUrl, options);
  const resText = response.getContentText();
  
  // --- ส่วนที่เพิ่มความปลอดภัย: เช็คว่าเป็น HTML หรือ JSON ก่อน Parse ---
  let resJson;
  try {
    resJson = JSON.parse(resText);
  } catch (e) {
    // ถ้าพังตรงนี้ แสดงว่า Google ส่ง HTML Error มา (เช่น 404 หรือ 400)
    console.error("❌ ไม่สามารถ Parse JSON ได้! อาจเป็นเพราะ URL ผิดหรือ Token หมดอายุ");
    console.error("URL ที่เรียกคือ: " + finalUrl);
    console.error("ข้อความที่ตอบกลับมา (บางส่วน): " + resText.substring(0, 300));
    return { error: "HTML_RESPONSE_ERROR", details: resText.substring(0, 100) };
  }
  
  if (resJson.error) {
    console.error("⚠️ Firestore Error: " + JSON.stringify(resJson.error));
  }
  
  return resJson;
}

