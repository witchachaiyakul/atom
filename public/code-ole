function getAllInvoicesForSearch(mode) {
  try {
    // กำหนดสถานะที่จะค้นหา (เริ่มต้นเป็น unpaid ถ้าไม่มีการส่งค่ามา)
    const currentMode = mode || 'unpaid';
    console.log("--- [START] ดึงข้อมูลโหมด: " + currentMode + " ---");

    // เตรียมค่าเงื่อนไขสำหรับฟิลด์ 'paid'
    let paidFilterValues = [];
    
    if (currentMode === 'paid') {
      // เงื่อนไขสำหรับ "จ่ายแล้ว"
      paidFilterValues = [
        { "stringValue": "true" },
        { "booleanValue": true }
      ];
    } else {
      // เงื่อนไขสำหรับ "ค้างจ่าย"
      paidFilterValues = [
        { "stringValue": "" },
        { "stringValue": "false" },
        { "booleanValue": false }
      ];
    }

    const queryPayload = {
      "structuredQuery": {
        "from": [{ "collectionId": "expense" }],
        "where": {
          "fieldFilter": {
            "field": { "fieldPath": "paid" },
            "op": "IN", 
            "value": {
              "arrayValue": {
                "values": paidFilterValues // ใช้ตัวแปรเงื่อนไขที่เลือกไว้ด้านบน
              }
            }
          }
        },
        "orderBy": [
          {
            "field": { "fieldPath": "doc_date" },
            "direction": "DESCENDING"
          }
        ],
        "limit": 1000 
      }
    };

    // ส่งคำขอไปที่ Firestore
    const response = callFirestore("POST", ":runQuery", queryPayload);

    // ตรวจสอบ Error
    if (response.error) {
      console.error("--- [ERROR] Firestore Query Error ---");
      console.error("Message: " + response.error.message);
      return [];
    }

    if (!response || !Array.isArray(response)) return [];

    const mappedResults = response
      .filter(item => item.document) 
      .map(item => {
        const doc = item.document;
        const f = fromFirestoreFields(doc.fields);
        const docId = doc.name.split('/').pop();

        // 🎯 ส่งค่ากลับหน้าบ้านครบถ้วนทุกตัวแปรเดิมของพี่วิชชา และดึงฟิลด์ url, receipt, slip ครบทั้ง 3 ฟิลด์
        return {
          docId: docId,
          no:          f.doc_no || "",
          dateRaw:     f.doc_date || "",
          date:        f.doc_date ? f.doc_date.split('-').reverse().join('/') : "", 
          description: f.list || "",
          supplier:    f.supplier || "",
          shop:        f.shop || "",
          amount:      parseFloat(f.net_amount) || 0,
          invNo:       f.invoice_no || "",
          isSet:       (f.clam_sub === "true" || f.clam_sub === true),
          payChannel:  f.pay_ch || "",
          payDateRaw:  f.pay_day || "",
          isPaid:      (f.paid === "true" || f.paid === true), // คืนค่าจริงจากฐานข้อมูล
          
          // ผูกส่งข้อมูลออกไปหน้าบ้านพร้อมกันทั้ง 3 ฟิลด์
          invoiceUrl:  f.url || "",
          receipt:     f.receipt || "",
          slip:        f.slip || ""
        };
      });

    console.log("--- [FINISH] พบรายการ " + currentMode + " ทั้งหมด " + mappedResults.length + " รายการ ---");
    return mappedResults;

  } catch (e) {
    console.error("Error ใน getAllInvoicesForSearch: " + e.toString());
    return [];
  }
}

function updateInvoiceFull(p, userObj) { // 🎯 1. เพิ่มพารามิเตอร์ userObj มารับค่าโปรไฟล์จากหน้าบ้าน
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000); 
    if (!p.docId) throw new Error("ไม่ระบุรหัสเอกสาร (docId)");

    let combinedUrls = "";
    
    // -------------------------------------------------------------------------
    // 🎯 [ท่อที่ 1: โค้ดลูป p.fileData เดิมของพี่วิชชา 100%]
    // ปรับเพียงดึงค่า Token จาก Response Success เพื่อแก้บั๊กรูปหน้าจอขาว 403 
    // -------------------------------------------------------------------------
    if (p.fileData && Array.isArray(p.fileData) && p.fileData.length > 0) {
      const scriptProperties = PropertiesService.getScriptProperties();
      const keyFileRaw = scriptProperties.getProperty('FIREBASE_KEY');
      if (!keyFileRaw) throw new Error("ไม่พบคีย์ FIREBASE_KEY ในระบบ Script Properties");
      
      const keyFile = JSON.parse(keyFileRaw);
      const token = getAccessToken(keyFile); 
      const bucketName = "atom-group-phi-phi.firebasestorage.app";
      
      let year = "2026", month = "01", day = "01";
      if (p.date && p.date.includes("-")) {
        const dateParts = p.date.split("-");
        year = dateParts[0] || "2026";
        month = (dateParts[1] || "01").padStart(2, '0');
        day = (dateParts[2] || "01").padStart(2, '0');
      }
      
      const shopFolder = getUnifiedShopName(p.shop);
      const invNo = p.invoice_no ? p.invoice_no.trim() : "NO-IV";
      const netAmt = parseFloat(p.net_amount) || 0;
      let urlList = [];

      p.fileData.forEach((f, index) => {
        const bytes = Utilities.base64Decode(f.base64);
        const ext = f.fileName.split('.').pop();
        const finalFileName = `${invNo}_${p.supplier}_${netAmt}_${index + 1}.${ext}`;
        const firebasePath = `invoice_library/${shopFolder}/${year}/${month}/${day}/${finalFileName}`;
        const blob = Utilities.newBlob(bytes, f.mimeType, finalFileName);
        
        const uploadUrl = "https://firebasestorage.googleapis.com/v0/b/" + bucketName + "/o?uploadType=media&name=" + encodeURIComponent(firebasePath);
        const uploadOptions = {
          method: "POST", contentType: f.mimeType, payload: blob, headers: { Authorization: "Bearer " + token }, muteHttpExceptions: true
        };
        
        const uploadResponse = UrlFetchApp.fetch(uploadUrl, uploadOptions);
        if (uploadResponse.getResponseCode() !== 200) {
          throw new Error("อัปโหลดไฟล์เข้า Firebase Storage ล้มเหลว: " + uploadResponse.getContentText());
        }

        // แกะเอาค่า downloadTokens แท้จากเซิร์ฟเวอร์โดยไม่ต้องส่งคำขอ PATCH ไปซ้อน เพื่อความเสถียร
        const responseData = JSON.parse(uploadResponse.getContentText());
        const downloadToken = responseData.downloadTokens;
        
        urlList.push(`https://firebasestorage.googleapis.com/v0/b/${bucketName}/o/${encodeURIComponent(firebasePath)}?alt=media&token=${downloadToken}`);
      });
      combinedUrls = urlList.join("\n"); 
    }

    // -------------------------------------------------------------------------
    // 🎯 [ท่อที่ 2: เขียนเพิ่มขยาย] รองรับรูปฝั่ง ใบเสร็จ (receipt) เข้าฟิลด์เฉพาะกลุ่ม
    // -------------------------------------------------------------------------
    let receiptUrlResult = "";
    if (p.receiptFileData && p.receiptFileData.base64) {
      const scriptProperties = PropertiesService.getScriptProperties();
      const keyFileRaw = scriptProperties.getProperty('FIREBASE_KEY');
      const token = getAccessToken(JSON.parse(keyFileRaw));
      const bucketName = "atom-group-phi-phi.firebasestorage.app";
      
      let year = "2026", month = "01", day = "01";
      if (p.date && p.date.includes("-")) {
        const dateParts = p.date.split("-");
        year = dateParts[0] || "2026";
        month = (dateParts[1] || "01").padStart(2, '0');
        day = (dateParts[2] || "01").padStart(2, '0');
      }
      const shopFolder = getUnifiedShopName(p.shop);
      const invNo = p.invoice_no ? p.invoice_no.trim() : "NO-IV";
      const netAmt = parseFloat(p.net_amount) || 0;
      
      const rExt = p.receiptFileData.fileName.split('.').pop();
      const receiptFileName = `${invNo}_${p.supplier}_${netAmt}_receipt.${rExt}`;
      const receiptPath = `invoice_library/${shopFolder}/${year}/${month}/${day}/${receiptFileName}`;
      const rBytes = Utilities.base64Decode(p.receiptFileData.base64);
      const rBlob = Utilities.newBlob(rBytes, p.receiptFileData.mimeType, receiptFileName);
      
      const rUploadUrl = "https://firebasestorage.googleapis.com/v0/b/" + bucketName + "/o?uploadType=media&name=" + encodeURIComponent(receiptPath);
      const rResponse = UrlFetchApp.fetch(rUploadUrl, {
        method: "POST", contentType: p.receiptFileData.mimeType, payload: rBlob, headers: { Authorization: "Bearer " + token }, muteHttpExceptions: true
      });
      if (rResponse.getResponseCode() !== 200) throw new Error("บันทึกไฟล์ใบเสร็จล้มเหลว");
      
      const rToken = JSON.parse(rResponse.getContentText()).downloadTokens;
      receiptUrlResult = `https://firebasestorage.googleapis.com/v0/b/${bucketName}/o/${encodeURIComponent(receiptPath)}?alt=media&token=${rToken}`;
    }

    // -------------------------------------------------------------------------
    // 🎯 [ท่อที่ 3: เขียนเพิ่มขยาย] รองรับรูปฝั่ง สลิปโอนเงิน (slip) เข้าฟิลด์เฉพาะกลุ่ม
    // -------------------------------------------------------------------------
    let slipUrlResult = "";
    if (p.slipFileData && p.slipFileData.base64) {
      const scriptProperties = PropertiesService.getScriptProperties();
      const keyFileRaw = scriptProperties.getProperty('FIREBASE_KEY');
      const token = getAccessToken(JSON.parse(keyFileRaw));
      const bucketName = "atom-group-phi-phi.firebasestorage.app";
      
      let year = "2026", month = "01", day = "01";
      if (p.date && p.date.includes("-")) {
        const dateParts = p.date.split("-");
        year = dateParts[0] || "2026";
        month = (dateParts[1] || "01").padStart(2, '0');
        day = (dateParts[2] || "01").padStart(2, '0');
      }
      const shopFolder = getUnifiedShopName(p.shop);
      const invNo = p.invoice_no ? p.invoice_no.trim() : "NO-IV";
      const netAmt = parseFloat(p.net_amount) || 0;
      
      const sExt = p.slipFileData.fileName.split('.').pop();
      const slipFileName = `${invNo}_${p.supplier}_${netAmt}_slip.${sExt}`;
      const slipPath = `slip_library/${shopFolder}/${year}/${month}/${day}/${slipFileName}`;
      const sBytes = Utilities.base64Decode(p.slipFileData.base64);
      const sBlob = Utilities.newBlob(sBytes, p.slipFileData.mimeType, slipFileName);
      
      const sUploadUrl = "https://firebasestorage.googleapis.com/v0/b/" + bucketName + "/o?uploadType=media&name=" + encodeURIComponent(slipPath);
      const sResponse = UrlFetchApp.fetch(sUploadUrl, {
        method: "POST", contentType: p.slipFileData.mimeType, payload: sBlob, headers: { Authorization: "Bearer " + token }, muteHttpExceptions: true
      });
      if (sResponse.getResponseCode() !== 200) throw new Error("บันทึกไฟล์สลิปล้มเหลว");
      
      const sToken = JSON.parse(sResponse.getContentText()).downloadTokens;
      slipUrlResult = `https://firebasestorage.googleapis.com/v0/b/${bucketName}/o/${encodeURIComponent(slipPath)}?alt=media&token=${sToken}`;
    }

    // -------------------------------------------------------------------------
    // ประกอบร่างส่งขึ้น Firestore (รวมเขียนสิทธิ์ขนานกันทั้ง 3 ฟิลด์ข้อมูลไฟล์)
    // -------------------------------------------------------------------------
    const updateData = {
      doc_date: p.date, list: p.list, supplier: p.supplier,
      shop: getUnifiedShopName(p.shop), 
      net_amount: parseFloat(p.net_amount) || 0, total_amount: parseFloat(p.net_amount) || 0, 
      invoice_no: p.invoice_no, clam_sub: p.clam_sub, pay_ch: p.pay_ch, pay_day: p.pay_day, paid: p.paid,
      timestamp_update: new Date().toISOString()
    };

    if (combinedUrls !== "") updateData.url = combinedUrls;
    if (receiptUrlResult !== "") updateData.receipt = receiptUrlResult;
    if (slipUrlResult !== "") updateData.slip = slipUrlResult;

    let mask = Object.keys(updateData).map(key => "updateMask.fieldPaths=" + key).join('&');
    if (callFirestore("PATCH", "expense/" + encodeURIComponent(p.docId) + "?" + mask, toFirestoreFields(updateData)).error) throw new Error("Firestore Update Error");

    // 🎯 2. เปลี่ยนส่งพารามิเตอร์ท้ายสุดจาก null เป็น userObj เพื่อลงล็อกชื่อพนักงานคนแก้ไขบิลจริง
    if (typeof insertAuditLog === 'function') {
      insertAuditLog("UPDATE_INVOICE", `แก้ไขข้อมูลบิล: ${p.docId} ร้าน: ${getUnifiedShopName(p.shop)}`, userObj);
    }

    return "success";
  } catch (e) {
    throw new Error("บันทึกไม่สำเร็จ: " + e.message);
  } finally {
    lock.releaseLock();
  }
}

/** 1. ฟังก์ชันส่งคืนรายชื่อร้านค้า (ฉบับปรับปรุงการเรียงลำดับ) */
function getStoresForFilter() {
  try {
    const stores = [
      "Atom",
      "Atom Beach",
      "Good Time",
      "Paradise",
      "Tiger King Bar & Bistro"
    ];
    
