function getAccessToken(key) {
  // 1. ลองดึง Token จาก Cache ก่อน (จำไว้ได้สูงสุด 6 ชั่วโมงในระบบ Google)
  // 🎯 ปรับชื่อกุญแจแคชใหม่ เพื่อล้างตราสิทธิ์เก่าที่ไม่มีโควต้า Storage ทิ้งทันทีครับพี่
  const cache = CacheService.getScriptCache();
  const cachedToken = cache.get("firebase_master_token"); 
  
  if (cachedToken) {
    return cachedToken; // ถ้ามีของใหม่ที่สิทธิ์ครบและยังไม่หมดอายุ ให้ส่งกลับไปเลย
  }

  // 2. ถ้าไม่มีใน Cache หรือหมดอายุแล้ว ให้รันโค้ดเพื่อขอใหม่
  const header = JSON.stringify({ alg: "RS256", typ: "JWT" });
  const now = Math.floor(Date.now() / 1000);
  
  // 🎯 [แก้ไขเสร็จสิ้น]: เติมท่อสิทธิ์ cloud-platform เคาะเว้นวรรคต่อท้ายเข้าไปในระบบเรียบร้อยครับ
  const claimSet = JSON.stringify({
    iss: key.client_email,
    scope: "https://www.googleapis.com/auth/datastore https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/cloud-platform", 
    aud: "https://oauth2.googleapis.com/token",
    exp: now + 3600,
    iat: now
  });

  const encode = (str) => Utilities.base64EncodeWebSafe(str).replace(/=+$/, "");
  const signatureInput = encode(header) + "." + encode(claimSet);
  
  const privateKey = key.private_key.replace(/\\n/g, '\n');
  const signature = Utilities.computeRsaSha256Signature(signatureInput, privateKey);
  const jwt = signatureInput + "." + encode(signature);

  const options = {
    method: "POST",
    payload: {
      grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer",
      assertion: jwt
    },
    muteHttpExceptions: true
  };

  try {
    const response = UrlFetchApp.fetch("https://oauth2.googleapis.com/token", options);
    const data = JSON.parse(response.getContentText());
    const token = data.access_token;

    if (token) {
      // 3. บันทึก Token ตัวใหม่สิทธิ์เต็มลงใน Cache (เก็บไว้ 3000 วินาที หรือประมาณ 50 นาที)
      cache.put("firebase_master_token", token, 3000);
      return token;
    } else {
      throw new Error("ขอ Token ไม่สำเร็จ: " + response.getContentText());
    }
  } catch (e) {
    Logger.log("Error getAccessToken: " + e.message);
    return null;
  }
}

function fromFirestoreFields(fields) {
  const obj = {};
  for (const key in fields) {
    const val = fields[key];
    if (val.hasOwnProperty('stringValue')) obj[key] = val.stringValue;
    else if (val.hasOwnProperty('doubleValue')) obj[key] = Number(val.doubleValue);
    else if (val.hasOwnProperty('integerValue')) obj[key] = Number(val.integerValue);
    else if (val.hasOwnProperty('booleanValue')) obj[key] = val.booleanValue;
    else obj[key] = "";
  }
  return obj;
}

