function fetchSummaryDataStandalone(params) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(params.source);
  if (!sheet) return { total: 0, count: 0, rows: [] };

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return { total: 0, count: 0, rows: [] };

  // ✨ แก้ไข: ดึงข้อมูล A ถึง K (11 คอลัมน์) เพื่อให้ครอบคลุมยอดรวมที่คอลัมน์ K
  const data = sheet.getRange(2, 1, lastRow - 1, 11).getValues();
  
  const startDate = new Date(params.dateStart);
  startDate.setHours(0, 0, 0, 0);
  const endDate = new Date(params.dateEnd);
  endDate.setHours(23, 59, 59, 999); 
  
  const filterStore = params.store.trim().toLowerCase();
  const isSearchAll = (params.store === "All" || params.store === "ทั้งหมด");
  
  let total = 0;
  let filteredRows = [];

  data.forEach((row) => {
    const rawDate = row[1]; // คอลัมน์ B (วันที่)
    if (!(rawDate instanceof Date) && isNaN(new Date(rawDate).getTime())) return;
    
    const rowDate = new Date(rawDate);
    if (rowDate < startDate || rowDate > endDate) return;

    let isMatch = false;
    let amount = 0;
    let detail = {};

    // --- 1. กรณีแหล่งข้อมูลคือ Expense Record ---
    if (params.source === "Expense Record") {
      amount = parseFloat(String(row[5]).replace(/,/g, '')) || 0; // F (ยอดเงิน)
      const storeInSheet = String(row[4] || "").trim(); // E (ร้านค้า)
      const supplier = String(row[3] || "").trim();    // D (Supplier)
      
      if (isSearchAll || storeInSheet.toLowerCase() === filterStore) {
        isMatch = true;
        detail = { 
          date: Utilities.formatDate(rowDate, "GMT+7", "dd/MM/yyyy"),
          info: row[2],      
          supplier: supplier, 
          note: storeInSheet,
          money: amount 
        };
      }
    } 
    // --- 2. กรณีแหล่งข้อมูลคือ OCR ---
    else if (params.source === "OCR") {
      // ✨ แก้ไข: ยอดรวมย้ายไปที่คอลัมน์ K (Index 10)
      amount = parseFloat(String(row[10]).replace(/,/g, '')) || 0; 
      
      const payee    = String(row[3] || "").trim().toLowerCase(); // D
      const note     = String(row[6] || "").trim().toLowerCase(); // G
      const shop     = String(row[7] || "").trim();               // H (Shop)
      
      // ✨ แก้ไข: หมวดหมู่/ประเภทต้นทุน ย้ายมาที่คอลัมน์ J (Index 9)
      const category = String(row[9] || "").trim().toLowerCase(); 

      if (isSearchAll || 
          payee.includes(filterStore) || 
          note.includes(filterStore) || 
          shop.toLowerCase().includes(filterStore) ||
          category === filterStore) {
        
        isMatch = true;
        detail = { 
          date: Utilities.formatDate(rowDate, "GMT+7", "dd/MM/yyyy"),
          info: row[3], // D
          shop: shop,   
          // แสดงหมวดหมู่จากคอลัมน์ J ใน Note
          note: (row[9] ? "[" + row[9] + "] " : "") + (row[6] || "") + (shop ? " [" + shop + "]" : ""),
          money: amount 
        };
      }
    }

    if (isMatch) {
      total += amount;
      filteredRows.push(detail);
    }
  });

  return {
    total: total,
    count: filteredRows.length,
    rows: filteredRows
  };
}

function getCashOutReport(start, end, shopFilter, supplierFilter, categoryFilter) {
  console.log(`--- [START GS] getCashOutReport (Safe Multi-Path Mode) ---`);
  console.log(`ช่วง: ${start} ถึง ${end} | ร้าน: ${shopFilter} | คู่ค้า: ${supplierFilter} | ประเภท: ${categoryFilter}`);
  
  try {
    // 1. ดึงรายชื่อร้านค้าให้ตรงตามการสะกดในระบบปัจจุบันของคุณ
    let shopsToFetch = [];
    if (!shopFilter || shopFilter === "All") {
      shopsToFetch = ['Atom', 'Atom_Beach', 'Good_Time', 'Tiger_King_Bar_&_Bistro', 'Paradise'];
    } else {
      shopsToFetch = [shopFilter];
    }

    // 2. แตกช่วงวันที่เลือกจากหน้าบ้าน (start ถึง end) ออกมาเป็น Array ของแต่ละวัน (YYYY-MM-DD)
    let dateList = [];
    let currentDate = new Date(start);
    let endDate = new Date(end);
    
    while (currentDate <= endDate) {
      let yyyy = currentDate.getFullYear();
      let mm = String(currentDate.getMonth() + 1).padStart(2, '0');
      let dd = String(currentDate.getDate()).padStart(2, '0');
      dateList.push(`${yyyy}-${mm}-${dd}`);
      currentDate.setDate(currentDate.getDate() + 1);
    }

    let reportRows = [];
    let grandTotal = 0;

    // 3. วนลูปเจาะดึงเอกสารจากห้อง bills ตรงๆ ถอดแบบมาจากฟังก์ชัน getCashoutItems
    dateList.forEach(dateStr => {
      shopsToFetch.forEach(shop => {
        const targetSubCollection = `cashout/${shop}/days/${dateStr}/bills`;
        
        try {
          // เรียกดึงข้อมูลผ่าน GET ธรรมดาแบบที่ระบบเดิมทำอยู่ (ไม่ต้องใช้ Index)
          const response = callFirestore("GET", targetSubCollection);
          
          if (response && response.documents && Array.isArray(response.documents)) {
            response.documents.forEach(doc => {
              if (!doc.fields) return;
              
              // แปลงฟิลด์ด้วยฟังก์ชันเดิมของระบบคุณ
              const billFields = fromFirestoreFields(doc.fields) || {};
              
              const itemDate = dateStr; // 🎯 ดึงวันที่จากโฟลเดอร์ Path ตรงๆ ปลอดภัยที่สุด ไม่สนข้อความยาวๆ ข้างใน
              const itemShop = billFields.shop_bill || shop;
              const itemSupplier = billFields.supplier ? billFields.supplier.toString().trim() : "บิลเงินสด";
              const itemCategory = billFields.category || "ไม่ระบุประเภท";
              const itemAmount = parseFloat(billFields.bill_total) || parseFloat(billFields.total_amount) || 0;

              // 🎯 คัดกรองตัวเลือก Supplier และ Category ด้วยสคริปต์หลังบ้าน
              if (supplierFilter !== "All" && itemSupplier !== supplierFilter.toString().trim()) return;
              if (categoryFilter !== "All" && itemCategory !== categoryFilter.toString().trim()) return;

              grandTotal += itemAmount;
              reportRows.push({
                date: itemDate,
                shop_bill: itemShop,
                category: itemCategory,
                supplier: itemSupplier,
                bill_total: itemAmount
              });
            });
          }
        } catch (err) {
          // ข้ามโฟลเดอร์ที่ไม่มีข้อมูลหรือพิมพ์วันที่ผิดพลาด เพื่อไม่ให้ระบบหยุดทำงาน
          console.warn(`ไม่พบข้อมูลที่พิกัด ${targetSubCollection}: ` + err.message);
        }
      });
    });

    return {
      total: grandTotal,
      rows: reportRows
    };

  } catch (e) {
    console.error("เกิดข้อผิดพลาดในการประมวลผลรายงานแบบ Path: " + e.toString());
    return { total: 0, rows: [] };
  }
}

