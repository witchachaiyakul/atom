function deleteInvoiceFromFirestore(docId, userObj) { // 🎯 1. เพิ่มพารามิเตอร์ userObj มารับค่าโปรไฟล์จากหน้าบ้าน
  try {
    // 🎯 1. ดึงข้อมูลบิลจาก Firestore ขึ้นมาตรวจสอบก่อน (ถ้าลบเอกสารก่อน จะไม่รู้พิกัดไฟล์ใน Storage)
    const docRes = callFirestore("GET", `expense/${encodeURIComponent(docId)}`);
    
    if (docRes && docRes.fields) {
      const f = fromFirestoreFields(docRes.fields);
      const fileUrls = f.url || "";
      
      // ตรวจสอบว่าบิลใบนี้มีลิงก์รูปภาพผูกอยู่บน Firebase Storage หรือไม่
      if (fileUrls && fileUrls !== "-" && fileUrls.includes("firebasestorage.googleapis.com")) {
        const scriptProperties = PropertiesService.getScriptProperties();
        const keyFileRaw = scriptProperties.getProperty('FIREBASE_KEY');
        
        if (keyFileRaw) {
          const keyFile = JSON.parse(keyFileRaw);
          const token = getAccessToken(keyFile); // 使用 Token 权限
          const bucketName = "atom-group-phi-phi.firebasestorage.app";
          
          // รองรับกรณีบิลใบนั้นมีหลายรูปภาพ (ที่ถูกคั่นด้วยเครื่องหมายเว้นบรรทัด \n)
          const urls = fileUrls.split("\n");
          urls.forEach(url => {
            const trimmedUrl = url.trim();
            if (!trimmedUrl) return;
            
            // ✂️ แกะเอาพิกัดโฟลเดอร์ลึก (encodedPath) ที่อยู่ระหว่างข้อความ /o/ และเครื่องหมาย ? ออกมา
            const match = trimmedUrl.match(/\/o\/(.+?)\?/);
            if (match && match[1]) {
              const encodedPath = match[1]; // จะได้ค่าเช่น invoice_library%2FAtom%2F...
              const deleteStorageUrl = `https://firebasestorage.googleapis.com/v0/b/${bucketName}/o/${encodedPath}`;
              
              const deleteOptions = {
                method: "DELETE",
                headers: { Authorization: "Bearer " + token },
                muteHttpExceptions: true
              };
              
              // สั่งยิงคำสั่งระเบิดไฟล์ทิ้งจากคลัง Firebase Storage
              const deleteResponse = UrlFetchApp.fetch(deleteStorageUrl, deleteOptions);
              
              if (deleteResponse.getResponseCode() === 200) {
                console.log(`✅ ลบไฟล์ในคลัง Storage สำเร็จ: ${decodeURIComponent(encodedPath)}`);
              } else {
                // หากไฟล์ไม่มีอยู่จริงหรือเคยโดนลบไปแล้ว ให้บันทึก Log เตือนแต่ไม่สั่งให้โค้ดพัง เพื่อให้ระบบลบข้อความฐานข้อมูลต่อไปได้ครับ
                console.error(`⚠️ ไม่สามารถลบไฟล์ใน Storage ได้ (หรือไฟล์ไม่มีอยู่แล้ว): ${deleteResponse.getContentText()}`);
              }
            }
          });
        }
      }
    }

    // 🎯 2. [โค้ดเดิมของพี่]: 使用 DELETE คำสั่งลบตัวเอกสารข้อความออกจากตาราง Firestore
    const res = callFirestore("DELETE", `expense/${encodeURIComponent(docId)}`);

    if (res && res.error) {
      throw new Error(res.error.message);
    }

    // 🎯 3. [แก้ไขจุดสำคัญ]: เปลี่ยนส่งพารามิเตอร์ท้ายสุดจาก null เป็น userObj เพื่อลงล็อกชื่อพนักงานคนกดสั่งลบจริง
    insertAuditLog("DELETE_INVOICE", `ลบบิลเลขที่: ${docId}`, userObj);

    return "success";
  } catch (e) {
    console.error("Delete Invoice Error: " + e.toString());
    throw new Error("ไม่สามารถลบข้อมูลได้: " + e.message);
  }
}

